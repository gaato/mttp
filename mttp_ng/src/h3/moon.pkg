import {
  "gaato/mttp/trust",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async/types",
}

import {
  "gaato/mttp_ng/h3",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
} for "test"

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/types",
  ],
  "native-stub": [ "h3_stub.c" ],
  // The include flags pkg-config gives (build.js); the link flags reach
  // every program through build.js's link_configs.
  link: { "native": { "stub-cc-flags": "${build.H3_CFLAGS}" } },
)
