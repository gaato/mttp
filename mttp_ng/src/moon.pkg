import {
  "gaato/mttp_core",
  "gaato/mttp_core/h1client",
  "gaato/mttp_core/h1server",
  "gaato/mttp_core/rt",
  "gaato/mttp/codings",
  "gaato/mttp/runtime",
  "gaato/mttp/server",
  "gaato/mttp/trust",
  "gaato/mttp_ng/h2client",
  "gaato/mttp_ng/h2server",
  "gaato/mttp_ng/h3",
  "gaato/mttp_ng/h3client",
  "gaato/mttp_ng/h3server",
  "gaato/mttp_ng/tls",
  "moonbitlang/core/async",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/env",
}

import {
  "gaato/mttp",
  "gaato/mttp_core",
  "gaato/mttp_core/h1client",
  "gaato/mttp_ng",
  "moonbitlang/core/async",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
} for "test"

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/cond_var",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/socket",
  ],
)
