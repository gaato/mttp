import {
  "gaato/mttp",
  "gaato/mttp/rt",
  "gaato/mttp/h1client",
  "gaato/mttp/h1server",
  "gaato/http-async/backend",
  "gaato/http-async/runtime",
  "moonbitlang/core/async",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/bench",
}

pkgtype(kind: "executable")

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "gaato/mttp/h1client",
    "gaato/mttp/h1server",
    "moonbitlang/core/async",
    "moonbitlang/core/async/socket",
  ],
)
