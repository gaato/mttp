import {
  "gaato/mttp_core",
  "gaato/mttp_core/rt",
  "gaato/mttp_core/h1client",
  "gaato/mttp_core/h1server",
  "gaato/mttp/backend",
  "gaato/mttp/runtime",
  "moonbitlang/core/async",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/bench",
}

pkgtype(kind: "executable")

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/socket",
  ],
)
