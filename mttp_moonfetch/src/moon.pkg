import {
  "gaato/mttp",
  "gaato/mttp_async/codings",
  "moonbitstack/moonfetch",
  "moonbitstack/moonhttp/method",
  "moonbitstack/moonhttp/http1",
  "moonbitstack/moonhttp/http2",
  "moonbitstack/moonhttp/http3",
  "moonbitstack/moontls/tls",
  "moonbitstack/moontls/alert",
  "moonbitlang/async/os_error",
  "moonbitlang/async/socket",
  "moonbitlang/core/async",
  "moonbitlang/core/debug",
}

import {
  "gaato/mttp",
  "gaato/mttp/sim",
  "gaato/mttp_async",
  "gaato/mttp_async/server",
  "moonbitstack/moontls/tls",
  "moonbitstack/mooncred/x509",
  "moonbitstack/moonnet/tcp",
  "moonbitstack/moonhttp/http2",
  "moonbitstack/moonhttp/header",
  "moonbitlang/core/async",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
} for "test"

// Not js: there gaato/mttp_async's backend is the host's fetch, which already
// negotiates HTTP/2 and HTTP/3, and moonfetch would only grow the bundle.

supported_targets = "native + wasm"

// Not marked experimental: the only experimental package of the family is
// gaato/mttp/driver, which relies on compiler intrinsics. What this one
// depends on (moonfetch's error types, one error text) is said in its README
// and watched by the canary's moonfetch job.

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/cond_var",
  ],
)
