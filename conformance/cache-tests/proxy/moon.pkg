import {
  "gaato/mttp_core",
  "gaato/mttp_core/client/httpcache",
  "gaato/mttp/backend",
  "gaato/mttp/runtime",
  "gaato/mttp/server",
  "moonbitlang/core/async",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
