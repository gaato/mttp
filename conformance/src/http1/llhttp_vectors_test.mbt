///|
/// Cases where mttp's documented strictness gives another reading than
/// the source's, which is kept as `upstream`.
let llhttp_differences : String =
  #|case llhttp request/sample.md:314
  #|name No HTTP version
  #|side request
  #|wire GET /\r\n\r\n
  #|reason A request line needs an HTTP version (RFC 9112 section 3); mttp does not read HTTP/0.9 simple requests, which llhttp does.
  #|expect refused Malformed
  #|upstream request GET / 0.9
  #|upstream complete
  #|case llhttp request/sample.md:333
  #|name Line folding in header value with CRLF
  #|side request
  #|wire GET / HTTP/1.1\r\nHost: h\r\nLine1:   abc\r\n\tdef\r\n ghi\r\n\t\tjkl\r\n  mno \r\n\t \tqrs\r\nLine2: \t line2\t\r\nLine3:\r\n line3\r\nLine4: \r\n \r\nConnection:\r\n close\r\n\r\n
  #|note Host: h added after the request line
  #|note llhttp mode request-lenient-headers
  #|reason llhttp's lenient mode accepts obs-fold; mttp refuses it (CONTRACT.md "HTTP/1 codec": obs-fold is refused; RFC 9112 section 5.2 allows that).
  #|expect refused Malformed
  #|upstream request GET / 1.1
  #|upstream header host: h
  #|upstream header line1: abc\tdef ghi\t\tjkl  mno \t \tqrs
  #|upstream header line2: line2
  #|upstream header line3: line3
  #|upstream header line4: 
  #|upstream header connection: close
  #|upstream complete
  #|case llhttp request/sample.md:454
  #|name No LF after CR (lenient)
  #|side request
  #|wire GET / HTTP/1.1\rLine: 1\r\n
  #|note llhttp mode request-lenient-optional-lf-after-cr
  #|reason llhttp's lenient mode accepts a bare CR or LF as a line end; mttp requires CRLF (CONTRACT.md "HTTP/1 codec": strict CRLF; h1 README "What is refused": bare CR or LF).
  #|expect refused Malformed
  #|upstream incomplete
  #|case llhttp request/sample.md:571
