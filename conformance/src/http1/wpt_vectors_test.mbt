///|
/// Cases where mttp's documented strictness gives another reading than
/// the source's, which is kept as `upstream`.
let wpt_differences : String =
  #|case wpt h1-parsing SP after-num
  #|name SP at <after-num>
  #|side response
  #|wire HTTP/1.1 200  OK\r\nX-Frame-Options:DENY\r\nContent-Length: 5\r\n\r\nTest.
  #|reason The bytes are the same as those of `SP at <before-reason>`, which the table expects to be valid: a reason phrase may start with SP (RFC 9112 section 4: reason-phrase = 1*( HTAB / SP / VCHAR / obs-text )), so mttp reads both.
  #|expect response 200 1.1
  #|expect header x-frame-options: DENY
  #|expect header content-length: 5
  #|expect body Test.
  #|expect complete
  #|upstream refused Malformed
  #|case wpt h1-parsing COLON before-reason
  #|name COLON at <before-reason>
  #|side response
  #|wire HTTP/1.1 200 :OK\r\nX-Frame-Options:DENY\r\nContent-Length: 5\r\n\r\nTest.
  #|reason A colon is a VCHAR (RFC 5234 appendix B.1: %x21-7E), so it may appear in a reason phrase (RFC 9112 section 4) and in a field value (RFC 9110 section 5.5), and a field line ends its name at the first colon (RFC 9112 section 5.1); the table's comment says otherwise.
  #|expect response 200 1.1
  #|expect header x-frame-options: DENY
  #|expect header content-length: 5
  #|expect body Test.
  #|expect complete
  #|upstream refused Malformed
  #|case wpt h1-parsing COLON after-reason
  #|name COLON at <after-reason>
  #|side response
  #|wire HTTP/1.1 200 OK:\r\nX-Frame-Options:DENY\r\nContent-Length: 5\r\n\r\nTest.
  #|reason A colon is a VCHAR (RFC 5234 appendix B.1: %x21-7E), so it may appear in a reason phrase (RFC 9112 section 4) and in a field value (RFC 9110 section 5.5), and a field line ends its name at the first colon (RFC 9112 section 5.1); the table's comment says otherwise.
  #|expect response 200 1.1
  #|expect header x-frame-options: DENY
  #|expect header content-length: 5
  #|expect body Test.
  #|expect complete
  #|upstream refused Malformed
  #|case wpt h1-parsing COLON in-name
  #|name COLON at <in-name>
  #|side response
  #|wire HTTP/1.1 200 OK\r\nX-Frame:-Options:DENY\r\nContent-Length: 5\r\n\r\nTest.
  #|reason A colon is a VCHAR (RFC 5234 appendix B.1: %x21-7E), so it may appear in a reason phrase (RFC 9112 section 4) and in a field value (RFC 9110 section 5.5), and a field line ends its name at the first colon (RFC 9112 section 5.1); the table's comment says otherwise.
  #|expect response 200 1.1
  #|expect header x-frame: -Options:DENY
  #|expect header content-length: 5
  #|expect body Test.
  #|expect complete
  #|upstream refused Malformed
  #|case wpt h1-parsing COLON before-colon
  #|name COLON at <before-colon>
  #|side response
  #|wire HTTP/1.1 200 OK\r\nX-Frame-Options::DENY\r\nContent-Length: 5\r\n\r\nTest.
  #|reason A colon is a VCHAR (RFC 5234 appendix B.1: %x21-7E), so it may appear in a reason phrase (RFC 9112 section 4) and in a field value (RFC 9110 section 5.5), and a field line ends its name at the first colon (RFC 9112 section 5.1); the table's comment says otherwise.
  #|expect response 200 1.1
  #|expect header x-frame-options: :DENY
  #|expect header content-length: 5
  #|expect body Test.
  #|expect complete
  #|upstream refused Malformed
  #|case wpt h1-parsing COLON after-colon
  #|name COLON at <after-colon>
  #|side response
  #|wire HTTP/1.1 200 OK\r\nX-Frame-Options::DENY\r\nContent-Length: 5\r\n\r\nTest.
  #|reason A colon is a VCHAR (RFC 5234 appendix B.1: %x21-7E), so it may appear in a reason phrase (RFC 9112 section 4) and in a field value (RFC 9110 section 5.5), and a field line ends its name at the first colon (RFC 9112 section 5.1); the table's comment says otherwise.
  #|expect response 200 1.1
  #|expect header x-frame-options: :DENY
  #|expect header content-length: 5
  #|expect body Test.
  #|expect complete
  #|upstream refused Malformed
  #|case wpt h1-parsing COLON in-value
  #|name COLON at <in-value>
  #|side response
  #|wire HTTP/1.1 200 OK\r\nX-Frame-Options:DE:NY\r\nContent-Length: 5\r\n\r\nTest.
  #|reason A colon is a VCHAR (RFC 5234 appendix B.1: %x21-7E), so it may appear in a reason phrase (RFC 9112 section 4) and in a field value (RFC 9110 section 5.5), and a field line ends its name at the first colon (RFC 9112 section 5.1); the table's comment says otherwise.
