----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/env",
}
----

///|
/// The interoperability suite: gaato/mttp's client against nginx,
/// Caddy and Apache httpd, and its server against curl, Go, Python httpx,
/// Node, Bun, Deno and raw-socket probes, directly and behind the three
/// servers as reverse proxies, against Http11Probe directly, and the typed
/// endpoint/OpenAPI server against Schemathesis directly.
/// interop/README.md says what is tested.
///
///   moon run interop/run.mbtx [-- <prefix>...]
///
/// runs from the repository root (`scripts/gates.sh interop` does that) and
/// prints one line per case, PASS, FAIL or KNOWN, as interop/cases.tsv
/// expects. A <prefix> keeps only the runs whose `<side>/<where>` starts
/// with it, such as `client/native/nginx` or `server/raw`.
///
/// It needs podman or docker (INTEROP_ENGINE chooses; podman first),
/// openssl, a C compiler for moon's native target, and the ports 39000,
/// 39010, 39011, 39020, 39021, 39030 and 39031 free on 127.0.0.1 and
/// 127.0.0.2, plus 39040, 39060 and 39061 on 127.0.0.1. Every third-party program runs from the image
/// interop/images.tsv pins, on the host's network; nothing is installed on
/// the host. Work files go to _build/interop.

///|
suberror RunError {
  RunError(String)
}

///|
/// The name of the module in interop/moon.mod, which moon's build paths
/// follow. The modules under test are named only in interop/moon.mod, the
/// moon.pkg files and scripts/modules.tsv.
let interop_module : String = "gaato/mttp-interop"

///|
let work : String = "_build/interop"

///|
let server_addr : String = "127.0.0.1:39000"

///|
let native_client : String = "_build/native/debug/build/\{interop_module}/mttp_client/mttp_client.exe"

///|
let native_server : String = "_build/native/debug/build/\{interop_module}/mttp_server/mttp_server.exe"

///|
let openapi_server_addr : String = "127.0.0.1:39040"

///|
let openapi_server : String = "_build/native/debug/build/\{interop_module}/openapi_server/openapi_server.exe"

///|
let js_client_dir : String = "_build/js/debug/build/\{interop_module}/mttp_client"

///|
/// The third-party servers: name (as in images.tsv), plain port (TLS is the
/// next one), the container's mounts and command, and the prefix of the
/// client cases it serves: "" for the full layout interop/mttp_client
/// describes, or a narrower one for a server that serves only some of it,
/// so that a row whose server is `*` does not reach it.
priv struct Server {
  name : String
  port : Int32
  config : (String, String)
  command : Array[String]
  serves : String
}

///|
let servers : Array[Server] = [
  {
    name: "nginx",
    port: 39010,
    config: ("nginx.conf", "/etc/nginx/nginx.conf"),
    command: [],
    serves: "",
  },
  {
    name: "caddy",
    port: 39020,
    config: ("Caddyfile", "/etc/caddy/Caddyfile"),
    command: [
      "caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile",
    ],
    serves: "",
  },
  {
    name: "apache",
    port: 39030,
    config: ("httpd.conf", "/usr/local/apache2/conf/httpd.conf"),
    command: [],
    serves: "",
  },
  // RFC 9842's server side, for the client's dictionary cases only: no
  // widely used server codes dcb or dcz yet, and Node's zlib takes the raw
  // dictionaries RFC 9842 uses (interop/servers/dictionary.mjs).
  {
    name: "node",
    port: 39060,
    config: ("dictionary.mjs", "/srv/dictionary.mjs"),
    command: ["node", "/srv/dictionary.mjs"],
    serves: "dictionary-",
  },
]

///|
let runtimes : Array[String] = ["native", "node", "bun", "deno"]

///|
let schemes : Array[String] = ["http", "https"]

///|
let clients : Array[String] = [
  "curl", "go", "httpx", "node", "bun", "deno", "raw", "http11probe", "schemathesis",
]

///|
/// Http11Probe, built from source at this commit in the SDK image
/// images.tsv pins as `dotnet`, since the project publishes no image. To
/// update it, take the commit of the new release (or of main) and check
/// that it still builds with that SDK.
let http11probe_repo : String = "https://github.com/MDA2AV/Http11Probe.git"

///|
let http11probe_commit : String = "d50d818a0e008e9feb3bb9860ad5d9cc40342bc3"

///|
let http11probe_work : String = "\{work}/http11probe"

///|
let schemathesis_work : String = "\{work}/schemathesis"

///|
let targets : Array[String] = ["direct", "nginx", "caddy", "apache"]

// The expectations.

///|
priv struct Row {
  side : String
  id : String
  where_ : Array[String]
  expect : String
  note : String
}

///|
async fn read_rows() -> Array[Row] {
  let rows = []
  for raw in @fs.read_text("interop/cases.tsv").split("\n") {
    let line = raw.trim_end().to_owned()
    if line.is_empty() || line.has_prefix("#") || line.has_prefix("side\t") {
      continue
    }
    let cells = line.split("\t").map(s => s.to_owned()).to_array()
    guard cells is [side, id, where_, expect, .. rest] else {
      raise RunError("interop/cases.tsv: malformed row: \{line}")
    }
    let note = rest.join(" ")
    let exact = expect.strip_prefix("known:")
    // These section-13 groups require our encoder to use window 9. The
    // server declines offers; the client must fail unsupported responses
    // (RFC 7692 section 7). Admit only the observed exact verdicts here;
    // FAILED remains a failure for every other case and for missing fields.
    let window_decline = (
        side == "server" &&
        where_ == "autobahn/direct" &&
        (id == "ab-13.3.*" || id == "ab-13.5.*") &&
        expect == "known:UNIMPLEMENTED/OK"
      ) ||
      (
        side == "client" &&
        where_ == "native/autobahn" &&
        (
          id == "autobahn-13.3.*" ||
          id == "autobahn-13.5.*" ||
          id == "autobahn-13.7.*"
        ) &&
        expect == "known:FAILED/FAILED"
      )
    guard expect is ("pass" | "known" | "n/a") ||
      window_decline ||
      (
        exact is Some(pair) &&
        pair.split("/").count() == 2 &&
        pair.split("/").all(v => v is ("OK" | "INFORMATIONAL" | "NON-STRICT"))
      ) else {
      raise RunError("interop/cases.tsv: unknown expectation: \{line}")
    }
    if expect != "pass" && note.is_empty() {
      raise RunError("interop/cases.tsv: \{expect} needs a note: \{line}")
    }
    rows.push({
      side,
      id,
      where_: where_.split("/").map(s => s.to_owned()).to_array(),
      expect,
      note,
    })
  }
  rows
}

///|
/// Whether a `where` pattern covers a run: part by part, `*` or one of the
/// `|`-separated alternatives.
fn covers(pattern : Array[String], run : Array[String]) -> Bool {
  pattern.length() == run.length() &&
  pattern
  .iter()
  .zip(run.iter())
  .all(pair => pair.0 == "*" || pair.0.split("|").any(alt => alt == pair.1))
}

///|
/// Whether a row's case is a prefix, `<prefix>*`, which names every case
/// starting with `<prefix>`; a client that names its own cases (such as
/// Http11Probe's tests) reports them under one.
fn Row::is_prefix(self : Row) -> Bool {
  self.id.has_suffix("*")
}

///|
/// Whether a row decides case `id`: the same id, or a prefix of it.
fn Row::names(self : Row, id : String) -> Bool {
  if self.is_prefix() {
    id.has_prefix(self.id[:self.id.length() - 1])
  } else {
    self.id == id
  }
}

///|
/// The rows that cover one run, in table order.
fn rows_of(rows : Array[Row], side : String, run : String) -> Array[Row] {
  let parts = run.split("/").map(s => s.to_owned()).to_array()
  rows.filter(row => row.side == side && covers(row.where_, parts))
}

///|
/// The row that decides case `id` in a run: the last that names it.
fn decide(rows : Array[Row], id : String) -> Row? {
  for i = rows.length() - 1; i >= 0; i = i - 1 {
    if rows[i].names(id) {
      return Some(rows[i])
    }
  }
  None
}

///|
/// The cases to ask a run for, in table order: each case id or prefix once,
/// with the row that decides it (for a prefix, the last row whose prefix
/// covers it); `n/a` cases are left out.
fn plan(rows : Array[Row]) -> Array[Row] {
  let seen : Map[String, Bool] = Map([])
  let cases = []
  for row in rows {
    if seen.contains(row.id) {
      continue
    }
    seen[row.id] = true
    match decide(rows, row.id) {
      Some(decided) if decided.expect != "n/a" =>
        cases.push({ ..decided, id: row.id, })
      _ => ()
    }
  }
  cases
}

// Reporting.

///|
priv struct Tally {
  mut pass : Int32
  mut fail : Int32
  mut known : Int32
  failures : Array[String]
}

///|
/// Prints one case's line and counts it.
fn Tally::case(
  self : Tally,
  name : String,
  row : Row,
  result : (String, String)?,
  problem : String,
  quiet~ : Bool = false,
) -> Unit {
  let (verdict, detail) = match result {
    None => ("FAIL", "no result: \{problem}")
    Some(("ok", detail)) if row.expect == "pass" => ("PASS", detail)
    Some((actual, detail)) if row.expect.has_prefix("known:") => {
      let expected = row.expect["known:".length():].to_owned()
      if actual == expected {
        ("KNOWN", "\{detail} [\{row.note}]")
      } else {
        ("FAIL", "\{detail} [expected \{expected}, got \{actual}]")
      }
    }
    Some(("fail", detail)) if row.expect == "known" && !autobahn_case(row.id) =>
      ("KNOWN", "\{detail} [\{row.note}]")
    Some(("ok", detail)) =>
      (
        "FAIL",
        "\{detail} [passes, though interop/cases.tsv records a known quirk: \{row.note}]",
      )
    Some((_, detail)) => ("FAIL", detail)
  }
  match verdict {
    "PASS" => self.pass += 1
    "KNOWN" => self.known += 1
    _ => {
      self.fail += 1
      self.failures.push(name)
    }
  }
  if !quiet {
    println("\{verdict} \{name}: \{detail}")
  }
}

///|
/// Compares what a program printed with the run's rows and prints one line
/// per case: each case id the plan asked for, then each case the program
/// reported under a prefix, decided by the last row that names it. A case
/// no row names fails, a prefix no reported case falls under fails, and
/// cases decided `n/a` are not printed.
fn Tally::report(
  self : Tally,
  side : String,
  run : String,
  rows : Array[Row],
  cases : Array[Row],
  output : String,
  problem : String,
  quiet~ : Bool = false,
) -> Unit {
  let results : Map[String, (String, String)] = Map([])
  let order : Array[String] = []
  for line in output.split("\n") {
    guard line.has_prefix("CASE ") else { continue }
    let parts = line["CASE ".length():]
      .split(" ")
      .map(s => s.to_owned())
      .to_array()
    guard parts is [id, verdict, .. detail] else { continue }
    if !results.contains(id) {
      order.push(id)
    }
    results[id] = (
      reported_verdict(id, verdict, detail.to_owned()),
      detail.join(" "),
    )
  }
  let asked : Map[String, Bool] = Map([])
  for row in cases {
    if !row.is_prefix() {
      asked[row.id] = true
      self.case(
        "\{side} \{run} \{row.id}",
        row,
        results.get(row.id),
        problem,
        quiet~,
      )
    }
  }
  let covered : Map[String, Bool] = Map([])
  for id in order {
    if asked.contains(id) {
      continue
    }
    let name = "\{side} \{run} \{id}"
    match decide(rows, id) {
      Some(row) if row.expect == "n/a" => ()
      Some(row) if cases.any(c => c.is_prefix() && c.names(id)) => {
        for c in cases {
          if c.is_prefix() && c.names(id) {
            covered[c.id] = true
          }
        }
        self.case(name, row, results.get(id), problem, quiet~)
      }
      _ => {
        self.fail += 1
        self.failures.push(name)
        if !quiet {
          println(
            "FAIL \{name}: reported, but interop/cases.tsv has no row for it",
          )
        }
      }
    }
  }
  for row in cases {
    if row.is_prefix() && !covered.contains(row.id) {
      self.case("\{side} \{run} \{row.id}", row, None, problem, quiet~)
    }
  }
}

///|
fn autobahn_case(id : String) -> Bool {
  (id.has_prefix("ab-") && id != "ab-run") || id.has_prefix("autobahn-")
}

///|
/// Preserve both verdicts, including from the client's legacy ok/fail adapter.
/// Missing, duplicate or inconsistent fields are never a known result.
fn reported_verdict(
  id : String,
  marker : String,
  detail : Array[String],
) -> String {
  if !autobahn_case(id) {
    return marker
  }
  let behavior = detail.filter(s => s.has_prefix("behavior="))
  let close = detail.filter(s => s.has_prefix("close="))
  guard behavior is [behavior] && close is [close] else {
    return "invalid-verdict"
  }
  let pair = behavior["behavior=".length():].to_owned() +
    "/" +
    close["close=".length():].to_owned()
  if pair == "OK/OK" && marker == "ok" {
    "ok"
  } else if pair != "OK/OK" && (marker == "fail" || marker == pair) {
    pair
  } else {
    "invalid-verdict"
  }
}

// Processes and containers.

///|
/// Runs a command to its end and returns its exit status and output.
async fn capture(
  program : String,
  args : Array[String],
  timeout_ms~ : Int32 = 600000,
) -> (Int32, String, String) {
  let out = @shell.Cmd(program, args).output(timeout_ms~)
  (out.exit_code(), out.stdout(), out.stderr())
}

///|
/// Runs a setup command and stops the run if it fails.
async fn must(program : String, args : Array[String]) -> String {
  println("+ \{program} \{args.join(" ")}")
  let (status, out, err) = capture(program, args)
  if status != 0 {
    raise RunError("\{program} exited with status \{status}:\n\{out}\{err}")
  }
  out
}

///|
/// The container engine: INTEROP_ENGINE, else podman, else docker.
async fn find_engine() -> String {
  if @env.get_env_var("INTEROP_ENGINE") is Some(engine) && engine != "" {
    return engine
  }
  for engine in ["podman", "docker"] {
    let status = @shell.Cmd(
      engine,
      ["--version"],
      stdout=Discard,
      stderr=Discard,
    ).status() catch {
      _ => -1
    }
    if status == 0 {
      return engine
    }
  }
  raise RunError("neither podman nor docker is on PATH (or set INTEROP_ENGINE)")
}

///|
async fn read_images() -> Map[String, String] {
  let images : Map[String, String] = Map([])
  for raw in @fs.read_text("interop/images.tsv").split("\n") {
    let line = raw.trim_end().to_owned()
    if line.is_empty() || line.has_prefix("#") || line.has_prefix("name\t") {
      continue
    }
    guard line.split("\t").map(s => s.to_owned()).to_array() is [name, image] else {
      raise RunError("interop/images.tsv: malformed row: \{line}")
    }
    guard image.contains("@sha256:") else {
      raise RunError("interop/images.tsv: \{name} is not pinned by digest")
    }
    images[name] = image
  }
  images
}

///|
priv struct Env {
  engine : String
  images : Map[String, String]
  root : String
  /// Extra `run` arguments for containers that write into the work tree:
  /// docker runs them as the invoking user, so the files stay removable;
  /// rootless podman already maps root in the container to that user.
  user : Array[String]
}

///|
fn Env::image(self : Env, name : String) -> String {
  self.images[name]
}

///|
/// A bind mount of `path` (relative to the repository) at `at`, read-only
/// unless `writable`. `z` relabels it where SELinux is on.
fn Env::mount(
  self : Env,
  path : String,
  at : String,
  writable~ : Bool = false,
) -> Array[String] {
  let mode = if writable { "z" } else { "ro,z" }
  ["-v", "\{self.root}/\{path}:\{at}:\{mode}"]
}

///|
/// `run --rm` on the host's network with `args` before the image and
/// `command` after it.
fn Env::run_args(
  self : Env,
  image : String,
  args : Array[String],
  command : Array[String],
) -> Array[String] {
  ["run", "--rm", "--network", "host", ..args, self.image(image), ..command]
}

///|
/// Waits until something accepts TCP connections on `addr`.
async fn wait_port(
  addr : String,
  what : String,
  attempts~ : Int32 = 150,
) -> Unit {
  let parsed = @socket.Addr::parse(addr)
  for _ in 0..<attempts {
    let up = try {
      @socket.Tcp::connect(parsed).close()
      true
    } catch {
      _ => false
    }
    if up {
      return
    }
    @async.sleep(200)
  }
  raise RunError("\{what} does not accept connections on \{addr}")
}

///|
/// Refuses to start when a port the suite needs is taken.
async fn port_free(addr : String) -> Unit {
  let taken = try {
    @socket.Tcp::connect(@socket.Addr::parse(addr)).close()
    true
  } catch {
    _ => false
  }
  if taken {
    raise RunError("\{addr} is in use; the interop suite needs it")
  }
}

///|
/// Certificates for this run: a CA the clients trust and a server
/// certificate for 127.0.0.1, 127.0.0.2 and localhost.
async fn make_certs() -> Unit {
  let dir = "\{work}/certs"
  make_dir(dir)
  let ec = [
    "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes",
  ]
  ignore(
    must(
      "openssl",
      [
        "req",
        "-x509",
        ..ec,
        "-keyout",
        "\{dir}/ca.key",
        "-out",
        "\{dir}/ca.pem",
        "-days",
        "2",
        "-subj",
        "/CN=mttp interop CA",
        "-addext",
        "basicConstraints=critical,CA:TRUE",
        "-addext",
        "keyUsage=critical,keyCertSign,cRLSign",
      ],
    ),
  )
  ignore(
    must(
      "openssl",
      [
        "req",
        ..ec,
        "-keyout",
        "\{dir}/server.key",
        "-out",
        "\{dir}/server.csr",
        "-subj",
        "/CN=127.0.0.1",
      ],
    ),
  )
  @fs.write_text(
    "\{dir}/server.ext",
    "subjectAltName=IP:127.0.0.1,IP:127.0.0.2,DNS:localhost\nbasicConstraints=CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=serverAuth\n",
  )
  ignore(
    must("openssl", [
      "x509",
      "-req",
      "-in",
      "\{dir}/server.csr",
      "-CA",
      "\{dir}/ca.pem",
      "-CAkey",
      "\{dir}/ca.key",
      "-CAcreateserial",
      "-days",
      "2",
      "-extfile",
      "\{dir}/server.ext",
      "-out",
      "\{dir}/server.pem",
    ]),
  )
  // The servers in the containers read the key as whichever user they run.
  @fs.chmod("\{dir}/server.key", 0o644)
}

///|
/// Starts the three servers and waits for their ports.
async fn start_servers(env : Env) -> Unit {
  for server in servers {
    let name = "interop-\{server.name}"
    ignore(capture(env.engine, ["rm", "-f", name]))
    ignore(
      must(
        env.engine,
        [
          "run",
          "-d",
          "--rm",
          "--name",
          name,
          "--network",
          "host",
          ..env.mount("interop/servers/\{server.config.0}", server.config.1),
          ..env.mount("\{work}/certs", "/certs"),
          ..env.mount("\{work}/www", "/www"),
          env.image(server.name),
          ..server.command,
        ],
      ),
    )
  }
  for server in servers {
    for port in [server.port, server.port + 1] {
      wait_port("127.0.0.1:\{port}", server.name) catch {
        error => {
          let (_, out, err) = capture(env.engine, [
            "logs",
            "interop-\{server.name}",
          ])
          raise RunError("\{error}\n\{out}\{err}")
        }
      }
    }
  }
}

///|
async fn stop_servers(env : Env) -> Unit {
  for server in servers {
    ignore(capture(env.engine, ["rm", "-f", "interop-\{server.name}"]))
  }
}

///|
/// Builds what the server-side clients need: the Go client (a static
/// binary the host runs), httpx with its dependencies, and Http11Probe
/// when a run of it is selected.
async fn prepare_clients(env : Env, filters : Array[String]) -> Unit {
  make_dir("\{work}/go")
  ignore(
    must(
      env.engine,
      [
        "run",
        "--rm",
        ..env.user,
        ..env.mount("interop/clients/go", "/src"),
        ..env.mount("\{work}/go", "/out", writable=true),
        "-w",
        "/src",
        "-e",
        "CGO_ENABLED=0",
        "-e",
        "GOTOOLCHAIN=local",
        "-e",
        "GOFLAGS=-buildvcs=false",
        "-e",
        "HOME=/out",
        "-e",
        "GOCACHE=/out/cache",
        "-e",
        "GOPATH=/out/gopath",
        env.image("golang"),
        "go",
        "build",
        "-o",
        "/out/client",
        ".",
      ],
    ),
  )
  make_dir("\{work}/python")
  ignore(
    must(
      env.engine,
      [
        "run",
        "--rm",
        ..env.user,
        ..env.mount("interop/clients/python", "/src"),
        ..env.mount("\{work}/python", "/deps", writable=true),
        "--entrypoint",
        "pip",
        env.image("python"),
        "install",
        "--quiet",
        "--no-cache-dir",
        "--disable-pip-version-check",
        "--require-hashes",
        "--only-binary=:all:",
        "--upgrade",
        "--target",
        "/deps",
        "-r",
        "/src/requirements.txt",
      ],
    ),
  )
  // The same run keys the run loop selects with, so that a filter naming
  // one run (`server/http11probe/direct`) builds what that run needs.
  if targets.any(target => selected(filters, "server/http11probe/\{target}")) {
    build_http11probe(env)
  }
}

///|
/// Builds Http11Probe at its pinned commit into _build/interop/http11probe
/// (interop/clients/http11probe/build.sh); a build of the same commit is
/// kept, so later runs need no network.
async fn build_http11probe(env : Env) -> Unit {
  make_dir(http11probe_work)
  ignore(
    must(
      env.engine,
      [
        "run",
        "--rm",
        ..env.user,
        ..env.mount("interop/clients/http11probe", "/src"),
        ..env.mount(http11probe_work, "/work", writable=true),
        ..http11probe_env,
        "--entrypoint",
        "sh",
        env.image("dotnet"),
        "/src/build.sh",
        http11probe_repo,
        http11probe_commit,
      ],
    ),
  )
}

///|
/// The .NET settings of both Http11Probe containers: a home and NuGet cache
/// in the work directory, no telemetry and no first-run banner.
let http11probe_env : Array[String] = [
  "-e", "DOTNET_CLI_HOME=/work/home", "-e", "NUGET_PACKAGES=/work/nuget", "-e", "DOTNET_CLI_TELEMETRY_OPTOUT=1",
  "-e", "DOTNET_NOLOGO=1",
]

///|
/// Runs every Http11Probe test against the mttp server. The SDK image has
/// no Python and the Python image no .NET, so the probe writes its report
/// to _build/interop/http11probe/out and the adapter (`server_command`)
/// reads it in the Python image. A probe that fails leaves no report, and
/// the adapter says so.
async fn run_http11probe(env : Env) -> Unit {
  let out = "\{http11probe_work}/out"
  make_dir(out)
  if @fs.exists("\{out}/report.json") {
    @fs.remove("\{out}/report.json")
  }
  let (host, port) = match server_addr.rev_find(":") {
    Some(i) => (server_addr[:i].to_owned(), server_addr[i + 1:].to_owned())
    None => (server_addr, "80")
  }
  println("+ http11probe \{host}:\{port}")
  let (status, stdout, stderr) = capture(
    env.engine,
    env.run_args(
      "dotnet",
      [
        ..env.user,
        ..env.mount(http11probe_work, "/work", writable=true),
        ..http11probe_env,
        "--entrypoint",
        "dotnet",
      ],
      [
        "/work/bin/Http11Probe.Cli.dll", "--host", host, "--port", port, "--output",
        "/work/out/report.json",
      ],
    ),
  ) catch {
    error => (-1, "", "\{error}")
  }
  @fs.write_text(
    "\{out}/console.log",
    "exit status \{status}\n\{stdout}\{stderr}",
  )
}

///|
/// The image runs as its own non-root user. Under rootless Podman that user
/// maps to a subordinate UID that cannot write the host's work directory,
/// so run it as the container's root, which is the invoking host user there.
/// Docker already gets the host's UID and GID through `env.user`.
fn schemathesis_user(env : Env) -> Array[String] {
  if env.engine.contains("docker") {
    env.user
  } else {
    ["--user", "0:0"]
  }
}

///|
/// Runs Schemathesis's stateless phases against the document served by the
/// dedicated endpoint server. A nonzero status is expected when it finds a
/// conformance issue; the JSON report, not that status, decides CASE lines.
async fn run_schemathesis(env : Env) -> Unit {
  make_dir(schemathesis_work)
  let report = "\{schemathesis_work}/report.json"
  if @fs.exists(report) {
    @fs.remove(report)
  }
  println("+ schemathesis http://\{openapi_server_addr}/openapi.json")
  let checks = [
    "not_a_server_error", "status_code_conformance", "content_type_conformance",
    "response_headers_conformance", "response_schema_conformance", "negative_data_rejection",
    "positive_data_acceptance",
  ].join(",")
  let (status, stdout, stderr) = capture(
    env.engine,
    env.run_args(
      "schemathesis",
      [
        ..schemathesis_user(env),
        ..env.mount(schemathesis_work, "/work", writable=true),
      ],
      [
        "run",
        "http://\{openapi_server_addr}/openapi.json",
        "--checks",
        checks,
        "--phases",
        "examples,coverage,fuzzing",
        "--mode",
        "all",
        "--max-examples",
        "20",
        "--seed",
        "20261116",
        "--workers",
        "1",
        "--generation-database",
        "none",
        "--generation-with-security-parameters",
        "true",
        "--continue-on-failure",
        "--report",
        "json",
        "--report-json-path",
        "/work/report.json",
        "--no-color",
        "--output-sanitize",
        "false",
        "--output-truncate",
        "false",
      ],
    ),
  ) catch {
    error => (-1, "", "\{error}")
  }
  @fs.write_text(
    "\{schemathesis_work}/console.log",
    "exit status \{status}\n\{stdout}\{stderr}",
  )
}

// The runs.

///|
/// The command of a client-side run: the native client, or the js client
/// in the runtime's image.
fn client_command(
  env : Env,
  runtime : String,
  server : Server,
  scheme : String,
  cases : Array[String],
) -> (String, Array[String]) {
  let port = if scheme == "https" { server.port + 1 } else { server.port }
  let base = "\{scheme}://127.0.0.1:\{port}"
  let alt = "\{scheme}://127.0.0.2:\{port}"
  let ids = cases.join(",")
  if runtime == "native" {
    let ca = if scheme == "https" {
      "\{env.root}/\{work}/certs/ca.pem"
    } else {
      "-"
    }
    return (native_client, [base, alt, ca, ids])
  }
  // On js the host's fetch verifies certificates against its own store,
  // extended with the run's CA.
  let launch = match runtime {
    "deno" => ["--entrypoint", "deno"]
    _ => ["--entrypoint", runtime]
  }
  let script = match runtime {
    "deno" => ["run", "-A", "--cert", "/certs/ca.pem", "/app/mttp_client.js"]
    _ => ["/app/mttp_client.js"]
  }
  (
    env.engine,
    env.run_args(
      runtime,
      [
        ..launch,
        "-e",
        "NODE_EXTRA_CA_CERTS=/certs/ca.pem",
        ..env.mount(js_client_dir, "/app"),
        ..env.mount("\{work}/certs", "/certs"),
      ],
      [..script, base, alt, "-", ids],
    ),
  )
}

///|
/// The command of a server-side run: a client against the mttp server,
/// directly or through a proxy's /up prefix.
fn server_command(
  env : Env,
  client : String,
  target : String,
  cases : Array[String],
) -> (String, Array[String]) {
  let host = match target {
    "direct" => server_addr
    name =>
      match servers.search_by(s => s.name == name) {
        Some(i) => "127.0.0.1:\{servers[i].port}"
        None => server_addr
      }
  }
  let prefix = if target == "direct" { "" } else { "/up" }
  let base = "http://\{host}\{prefix}"
  let direct = "http://\{server_addr}"
  let ids = cases.join(",")
  match client {
    "go" => ("\{work}/go/client", [base, direct, ids])
    "curl" =>
      (
        env.engine,
        env.run_args(
          "curl",
          [
            "--entrypoint",
            "sh",
            ..env.mount("interop/clients/curl", "/src"),
            ..env.mount("\{work}/www", "/www"),
          ],
          ["/src/cases.sh", base, direct, ids],
        ),
      )
    "httpx" =>
      (
        env.engine,
        env.run_args(
          "python",
          [
            "--entrypoint",
            "python3",
            "-e",
            "PYTHONPATH=/deps",
            ..env.mount("interop/clients/python", "/src"),
            ..env.mount("\{work}/python", "/deps"),
          ],
          ["/src/client.py", base, direct, ids],
        ),
      )
    "raw" =>
      (
        env.engine,
        env.run_args(
          "python",
          [
            "--entrypoint",
            "python3",
            ..env.mount("interop/clients/python", "/src"),
          ],
          ["-I", "/src/probes.py", host, prefix, server_addr, ids],
        ),
      )
    // Only directly: through a proxy the probe would test the proxy.
    "http11probe" =>
      (
        env.engine,
        env.run_args(
          "python",
          [
            "--entrypoint",
            "python3",
            ..env.mount("interop/clients/http11probe", "/src"),
            ..env.mount("\{http11probe_work}/out", "/in"),
          ],
          ["-I", "/src/adapter.py", "/in/report.json", "/in/console.log", ids],
        ),
      )
    "schemathesis" =>
      (
        "moon",
        [
          "run",
          "interop/clients/schemathesis/adapter.mbtx",
          "--",
          "\{schemathesis_work}/report.json",
          "\{schemathesis_work}/console.log",
          ids,
        ],
      )
    runtime => {
      let script = match runtime {
        "deno" => ["run", "-A", "/src/client.mjs"]
        _ => ["/src/client.mjs"]
      }
      (
        env.engine,
        env.run_args(
          runtime,
          ["--entrypoint", runtime, ..env.mount("interop/clients/js", "/src")],
          [..script, base, direct, ids],
        ),
      )
    }
  }
}

///|
/// Runs one program and reports its cases.
async fn run_one(
  tally : Tally,
  side : String,
  run : String,
  rows : Array[Row],
  cases : Array[Row],
  command : (String, Array[String]),
) -> Unit {
  let (program, args) = command
  let (output, problem) = try capture(program, args, timeout_ms=600000) catch {
    error => ("", "\{program} did not finish: \{error}")
  } noraise {
    (status, out, err) => {
      let tail = err.split("\n").filter(l => !l.is_empty()).to_array()
      let last = tail[(tail.length() - 5).max(0):].to_owned().join(" | ")
      (out, "the program exited with status \{status}: \{last}")
    }
  }
  tally.report(side, run, rows, cases, output, problem)
}

///|
fn selected(filters : Array[String], key : String) -> Bool {
  filters.is_empty() || filters.any(f => key.has_prefix(f))
}

///|
/// Autobahn's fuzzingserver drives the native mttp WebSocket client. The
/// JSON adapter preserves every raw verdict; cases.tsv owns known outcomes.
async fn run_autobahn_client(env : Env, rows : Array[Row]) -> Int32 {
  let run = "native/autobahn"
  let rows = rows_of(rows, "client", run)
  let cases = plan(rows)
  port_free("127.0.0.1:39050")
  port_free("127.0.0.1:39051")
  ignore(
    must("moon", [
      "build", "--release", "--target", "native", "interop/ws_client",
    ]),
  )
  // The client tolerates a failed final updateReports call and lets the
  // adapter judge the reports, so a previous run's reports must not remain.
  if @fs.exists("\{work}/autobahn-client/reports") {
    @fs.rmdir("\{work}/autobahn-client/reports", recursive=true)
  }
  make_dir("\{work}/autobahn-client/reports")
  let config = @fs.read_text("interop/servers/autobahn-client.json")
  let config = if compression_only() {
    config.replace(
      old="\"cases\": [\"*\"]",
      new="\"cases\": [\"12.*\", \"13.*\"]",
    )
  } else {
    config
  }
  let config_path = "\{work}/autobahn-client/config.json"
  @fs.write_text(config_path, config)
  let image = env.image("autobahn")
  if capture(env.engine, ["image", "inspect", image]).0 != 0 {
    ignore(must(env.engine, ["pull", "--quiet", image]))
  }
  let tally = { pass: 0, fail: 0, known: 0, failures: [], }
  // A cancelled Docker CLI can finish creating its container later. Give each
  // run a distinct name so an old cleanup cannot remove the next run's server.
  let container = "mttp-interop-ws-client-" +
    @env.rand(8).unwrap().to_array().map(b => b.to_int().to_string()).join("-")
  @fs.write_text("\{work}/autobahn-client/container.txt", container)
  @async.with_task_group(group => {
    defer @async.protect_from_cancel(() => {
      ignore(capture(env.engine, ["rm", "-f", container]))
    })
    let server = @process.spawn(
      group,
      env.engine,
      env.run_args(
        "autobahn",
        [
          "--name",
          container,
          ..env.user,
          ..env.mount(config_path, "/config/fuzzingserver.json"),
          ..env.mount(
            "\{work}/autobahn-client/reports",
            "/reports",
            writable=true,
          ),
        ],
        [],
      ),
      stdout=ToFile("\{work}/autobahn-client/server.log"),
      stderr=ToFile("\{work}/autobahn-client/server.log"),
    )
    defer server.cancel()
    // Container startup can outlast the ordinary 30 s port probe under load.
    wait_port("127.0.0.1:39050", "Autobahn fuzzingserver", attempts=900)
    // Sections 12/13 multiply the large-message matrix; the former ten-minute
    // command ceiling expires before the compression cases can finish.
    let (status, stdout, stderr) = capture(
      "_build/native/release/build/\{interop_module}/ws_client/ws_client.exe",
      [],
      timeout_ms=3600000,
    )
    @fs.write_text("\{work}/autobahn-client/client.log", stdout + stderr)
    if status != 0 {
      raise RunError("Autobahn client exited \{status}\n\{stdout}\n\{stderr}")
    }
    for line in stdout.split("\n") {
      if line.has_prefix("Autobahn updateReports") {
        println(line.to_owned())
      }
    }
    // Autobahn writes the reports for all 517 cases when updateReports
    // arrives, which takes minutes on a CI runner with sections 12 and 13;
    // the client's connection can end first. Wait for the index rather than
    // reading an absent one.
    let index = "\{work}/autobahn-client/reports/index.json"
    for waited = 0; !@fs.exists(index) && waited < 900; waited = waited + 1 {
      @async.sleep(1000)
    }
    run_one(
      tally,
      "client",
      run,
      rows,
      cases,
      (
        "moon",
        [
          "run",
          "interop/clients/autobahn/adapter.mbtx",
          "--",
          "\{work}/autobahn-client/reports/index.json",
          "mttp-client",
        ],
      ),
    )
  })
  println(
    "Autobahn client: \{tally.pass} passed, \{tally.known} known, \{tally.fail} failed",
  )
  if tally.fail == 0 {
    0
  } else {
    1
  }
}

///|
async fn main_run(filters : Array[String]) -> Int32 {
  if filters == ["websocket/local"] {
    return run_js_websockets(None)
  }
  let engine = find_engine()
  let images = read_images()
  let rows = read_rows().filter(row => {
    !compression_only() || compression_case(row.id)
  })
  let root = @fs.realpath(".")
  let user = if engine.contains("docker") {
    let uid = must("id", ["-u"]).trim().to_owned()
    let gid = must("id", ["-g"]).trim().to_owned()
    ["--user", "\{uid}:\{gid}"]
  } else {
    []
  }
  let env = { engine, images, root, user, }
  if filters == ["websocket"] {
    return run_js_websockets(Some(env))
  }
  if !filters.is_empty() &&
    filters.all(f => f.has_prefix("client/native/socks5h")) {
    return run_socks5h(env, rows, filters)
  }
  if !filters.is_empty() && filters.all(f => f.has_prefix("server/autobahn")) {
    return run_autobahn(env, rows)
  }
  println("interop: \{engine}, images pinned in interop/images.tsv")
  let socks_status = if filters.is_empty() ||
    filters.any(f => {
      "client/native/socks5h".has_prefix(f) ||
      f.has_prefix("client/native/socks5h")
    }) {
    run_socks5h(env, rows, filters)
  } else {
    0
  }
  let ws_status = if selected(filters, "client/native/autobahn") {
    run_autobahn_client(env, rows)
  } else {
    0
  }
  if !filters.is_empty() && filters.all(f => f == "client/native/autobahn") {
    return ws_status
  }
  for
    addr in [
      server_addr, "127.0.0.1:39010", "127.0.0.1:39020", "127.0.0.1:39030", openapi_server_addr,
      "127.0.0.1:39060", "127.0.0.1:39061",
    ] {
    port_free(addr)
  }
  ignore(
    must("moon", [
      "build", "--target", "native", "interop/mttp_client", "interop/mttp_server",
      "interop/openapi_server",
    ]),
  )
  ignore(must("moon", ["build", "--target", "js", "interop/mttp_client"]))
  make_dir(work)
  ignore(must(native_server, ["www", "\{work}/www"]))
  make_certs()
  for name, image in images {
    let (present, _, _) = capture(engine, ["image", "inspect", image])
    if present != 0 {
      println("+ \{engine} pull \{name}")
      ignore(must(engine, ["pull", "--quiet", image]))
    }
  }
  prepare_clients(env, filters)
  let tally = { pass: 0, fail: 0, known: 0, failures: [], }
  @async.with_task_group(group => {
    let server = @process.spawn(
      group,
      native_server,
      [server_addr],
      stdout=ToFile("\{work}/mttp_server.log"),
      stderr=ToFile("\{work}/mttp_server.log"),
    )
    defer server.cancel()
    wait_port(server_addr, "the mttp interop server")
    let api = @process.spawn(
      group,
      openapi_server,
      [openapi_server_addr],
      stdout=ToFile("\{work}/openapi_server.log"),
      stderr=ToFile("\{work}/openapi_server.log"),
    )
    defer api.cancel()
    wait_port(openapi_server_addr, "the mttp endpoint/OpenAPI interop server")
    // Cleanup first, so that a start failing partway removes what started.
    defer @async.protect_from_cancel(() => stop_servers(env))
    start_servers(env)
    for runtime in runtimes {
      for server in servers {
        for scheme in schemes {
          let run = "\{runtime}/\{server.name}/\{scheme}"
          let rows = rows_of(rows, "client", run).filter(row => {
            row.id.has_prefix(server.serves)
          })
          let cases = plan(rows)
          if cases.is_empty() || !selected(filters, "client/\{run}") {
            continue
          }
          run_one(
            tally,
            "client",
            run,
            rows,
            cases,
            client_command(env, runtime, server, scheme, cases.map(c => c.id)),
          )
        }
      }
    }
    for client in clients {
      for target in targets {
        let run = "\{client}/\{target}"
        let rows = rows_of(rows, "server", run)
        let cases = plan(rows)
        if cases.is_empty() || !selected(filters, "server/\{run}") {
          continue
        }
        if client == "http11probe" {
          run_http11probe(env)
        }
        if client == "schemathesis" {
          run_schemathesis(env)
        }
        run_one(
          tally,
          "server",
          run,
          rows,
          cases,
          server_command(env, client, target, cases.map(c => c.id)),
        )
      }
    }
  })
  println(
    "\ninterop: \{tally.pass} passed, \{tally.known} known, \{tally.fail} failed",
  )
  for name in tally.failures {
    println("  FAIL \{name}")
  }
  let autobahn = if selected(filters, "server/autobahn/direct") {
    run_autobahn(env, rows)
  } else {
    0
  }
  if tally.fail > 0 || autobahn != 0 || ws_status != 0 || socks_status != 0 {
    1
  } else {
    0
  }
}

///|
/// Client-only RFC 1928/1929 interoperability. The proxy admits only the
/// original FQDN localhost, so sending a locally resolved IP fails this run.
async fn run_socks5h(
  env : Env,
  rows : Array[Row],
  filters : Array[String],
) -> Int32 {
  for port in [39010, 39011, 39060] {
    port_free("127.0.0.1:\{port}")
  }
  ignore(
    must("moon", [
      "build", "--target", "native", "interop/mttp_client", "interop/mttp_server",
    ]),
  )
  make_dir(work)
  ignore(must(native_server, ["www", "\{work}/www"]))
  make_certs()
  for image in ["nginx", "socks5"] {
    ignore(must(env.engine, ["pull", "--quiet", env.image(image)]))
  }
  let names = ["mttp-c1-socks", "mttp-c1-socks-origin"]
  defer @async.protect_from_cancel(() => {
    for name in names {
      ignore(capture(env.engine, ["rm", "-f", name]))
    }
  })
  ignore(
    must(
      env.engine,
      env.run_args(
        "nginx",
        [
          "-d",
          "--name",
          names[1],
          ..env.mount("interop/servers/nginx.conf", "/etc/nginx/nginx.conf"),
          ..env.mount("\{work}/certs", "/certs"),
          ..env.mount("\{work}/www", "/www"),
        ],
        [],
      ),
    ),
  )
  ignore(
    must(
      env.engine,
      env.run_args(
        "socks5",
        [
          "-d",
          "--name",
          names[0],
          "-e",
          "PROXY_PORT=39060",
          "-e",
          "PROXY_USER=interop",
          "-e",
          "PROXY_PASSWORD=secret",
          "-e",
          "ALLOWED_DEST_FQDN=^localhost$",
          "-e",
          "ALLOWED_IPS=127.0.0.1",
        ],
        [],
      ),
    ),
  )
  wait_port("127.0.0.1:39010", "SOCKS HTTP origin")
  wait_port("127.0.0.1:39011", "SOCKS HTTPS origin")
  wait_port("127.0.0.1:39060", "SOCKS5 server")
  let tally = { pass: 0, fail: 0, known: 0, failures: [], }
  for scheme in ["http", "https"] {
    let run = "native/socks5h/\{scheme}"
    if !selected(filters, "client/\{run}") {
      continue
    }
    let expected = rows_of(rows, "client", run).filter(row => {
      row.id == "socks5h"
    })
    run_one(
      tally,
      "client",
      run,
      expected,
      plan(expected),
      (
        native_client,
        [
          "\{scheme}://localhost:\{if scheme == "http" { 39010 } else { 39011 }}",
          "socks5h://interop:secret@127.0.0.1:39060",
          "\{work}/certs/ca.pem",
          "socks5h",
        ],
      ),
    )
  }
  println("SOCKS5 interop: \{tally.pass} passed, \{tally.fail} failed")
  if tally.fail == 0 {
    0
  } else {
    1
  }
}

///|
// A focused run keeps the expensive uncompressed section 9 out of compression
// development, while the default interop run still covers every section.
fn compression_only() -> Bool {
  @env.get_env_var("INTEROP_WS_COMPRESSION_ONLY") == Some("1")
}

///|
fn compression_case(id : String) -> Bool {
  id == "ab-run" ||
  id.has_prefix("ab-12.") ||
  id.has_prefix("ab-13.") ||
  id.has_prefix("autobahn-12.") ||
  id.has_prefix("autobahn-13.")
}

///|
/// JS clients against W5's native server, then the same compiled fetch echo
/// on Deno and Bun. Default execution uses images.tsv; /local is an explicit
/// fallback for restricted hosts that cannot start containers.
async fn run_js_websockets(env : Env?) -> Int32 {
  ignore(must("moon", ["build", "--target", "native", "interop/mttp_server"]))
  ignore(
    must("moon", [
      "build", "--target", "js", "interop/ws_client", "examples/fetch/workers",
    ]),
  )
  make_dir(work)
  for address in ["127.0.0.1:39507", "127.0.0.1:39508", "127.0.0.1:39509"] {
    port_free(address)
  }
  let command = (runtime : String, path : String, args : Array[String]) => {
    match env {
      Some(env) => {
        let script = "/repo/\{path}"
        let args = if runtime == "deno" {
          ["run", "-A", script, ..args]
        } else {
          [script, ..args]
        }
        (
          env.engine,
          env.run_args(
            runtime,
            ["--entrypoint", runtime, ..env.mount(".", "/repo")],
            args,
          ),
        )
      }
      None =>
        (
          runtime,
          if runtime == "deno" {
            ["run", "-A", path, ..args]
          } else {
            [path, ..args]
          },
        )
    }
  }
  for runtime in ["node", "deno", "bun"] {
    match env {
      Some(env) =>
        ignore(must(env.engine, ["pull", "--quiet", env.image(runtime)]))
      None =>
        println(
          "websocket/local \{runtime}: \{must(runtime, ["--version"]).trim()}",
        )
    }
  }
  let rows = read_rows()
  let tally = { pass: 0, fail: 0, known: 0, failures: [], }
  let client = "_build/js/debug/build/\{interop_module}/ws_client/ws_client.js"
  @async.with_task_group(group => {
    let native = @process.spawn(
      group,
      native_server,
      ["websocket", "127.0.0.1:39507"],
      stdout=ToFile("\{work}/ws-native.log"),
      stderr=ToFile("\{work}/ws-native.log"),
    )
    defer native.cancel()
    wait_port("127.0.0.1:39507", "native WebSocket echo")
    for runtime in ["node", "deno", "bun"] {
      let run = "\{runtime}/websocket"
      let expected = rows_of(rows, "client", run)
      run_one(
        tally,
        "client",
        run,
        expected,
        plan(expected),
        command(runtime, client, ["ws://127.0.0.1:39507/"]),
      )
    }
    for (runtime, port) in [("deno", 39508), ("bun", 39509)] {
      let (program, args) = command(
        runtime,
        "interop/clients/js/websocket.mjs",
        [],
      )
      let args = match env {
        Some(_) =>
          [args[0], args[1], "--name", "mttp-w7-ws-\{runtime}", ..args[2:]]
        None => args
      }
      defer @async.protect_from_cancel(() => {
        if env is Some(env) {
          ignore(capture(env.engine, ["rm", "-f", "mttp-w7-ws-\{runtime}"]))
        }
      })
      let server = @process.spawn(
        group,
        program,
        args,
        stdout=ToFile("\{work}/ws-\{runtime}.log"),
        stderr=ToFile("\{work}/ws-\{runtime}.log"),
      )
      defer server.cancel()
      wait_port("127.0.0.1:\{port}", "\{runtime} WebSocket echo")
      let run = "\{runtime}/websocket"
      let expected = rows_of(rows, "server", run).filter(row => {
        row.id == "websocket"
      })
      run_one(
        tally,
        "server",
        run,
        expected,
        plan(expected),
        command("node", client, ["ws://127.0.0.1:\{port}/ws?shutdown"]),
      )
    }
  })
  println("WebSocket hosts: \{tally.pass} passed, \{tally.fail} failed")
  if tally.fail == 0 {
    0
  } else {
    1
  }
}

///|
/// Autobahn's report decides individual cases; a missing report never passes.
async fn run_autobahn(env : Env, all_rows : Array[Row]) -> Int32 {
  let dir = "\{work}/autobahn"
  make_dir(dir)
  let address = "127.0.0.1:39505"
  port_free(address)
  // Compression matrices exercise hundreds of MiB per case; use optimized
  // binaries so the verdict measures interoperability within suite deadlines.
  ignore(
    must("moon", [
      "build", "--release", "--target", "native", "interop/mttp_server",
    ]),
  )
  let image = env.image("autobahn")
  if capture(env.engine, ["image", "inspect", image]).0 != 0 {
    ignore(must(env.engine, ["pull", image]))
  }
  let config =
    #|{"outdir":"/work/reports","servers":[{"agent":"mttp","url":"ws://127.0.0.1:39505"}],"cases":["1.*","2.*","3.*","4.*","5.*","6.*","7.*","9.*","10.*","12.*","13.*"],"exclude-cases":[],"exclude-agent-cases":{}}
  let config = if compression_only() {
    config.replace(
      old="\"1.*\",\"2.*\",\"3.*\",\"4.*\",\"5.*\",\"6.*\",\"7.*\",\"9.*\",\"10.*\",",
      new="",
    )
  } else {
    config
  }
  @fs.write_text("\{dir}/config.json", config)
  let report = "\{dir}/reports/index.json"
  if @fs.exists(report) {
    @fs.remove(report)
  }
  @async.with_task_group(group => {
    let server = @process.spawn(
      group,
      "_build/native/release/build/\{interop_module}/mttp_server/mttp_server.exe",
      ["websocket", address],
      stdout=ToFile("\{dir}/server.log"),
      stderr=ToFile("\{dir}/server.log"),
    )
    defer server.cancel()
    wait_port(address, "mttp WebSocket echo server")
    defer @async.protect_from_cancel(() => {
      ignore(capture(env.engine, ["rm", "-f", "mttp-interop-ws-server"]))
    })
    let (status, stdout, stderr) = capture(
      env.engine,
      env.run_args(
        "autobahn",
        [
          "--name",
          "mttp-interop-ws-server",
          ..env.user,
          ..env.mount(dir, "/work", writable=true),
        ],
        ["wstest", "-m", "fuzzingclient", "-s", "/work/config.json"],
      ),
      timeout_ms=3600000,
    )
    @fs.write_text("\{dir}/console.log", "exit \{status}\n\{stdout}\n\{stderr}")
  })
  let (status, output, problem) = capture("moon", [
    "run", "interop/clients/autobahn/adapter.mbtx", "--", report,
  ])
  let rows = rows_of(all_rows, "server", "autobahn/direct")
  let tally = { pass: 0, fail: 0, known: 0, failures: [], }
  tally.report(
    "server",
    "autobahn/direct",
    rows,
    plan(rows),
    output,
    "adapter exit \{status}: \{problem}",
  )
  println(
    "autobahn: \{tally.pass} passed, \{tally.known} known, \{tally.fail} failed",
  )
  if tally.fail > 0 {
    1
  } else {
    0
  }
}

///|
async fn main {
  let args = @env.args()
  let filters = args[1:].to_owned().filter(a => a != "--")
  if filters == ["--self-test"] {
    self_test_autobahn()
    return
  }
  let status = main_run(filters) catch {
    RunError(message) => {
      println("interop: \{message}")
      2
    }
    error => {
      println("interop: \{error}")
      2
    }
  }
  @env.exit(status)
}

///|
/// A known Autobahn case must never hide protocol failures or absent verdicts,
/// on either side of the transport. Exercise the real reporting path.
async fn self_test_autobahn() -> Unit {
  for id in ["ab-run", "ab-12.*", "ab-13.1.1", "autobahn-12.*", "autobahn-13.1"] {
    assert_true(compression_case(id))
  }
  for id in ["ab-1.*", "autobahn-9.*", "ab-120.1", "headers"] {
    assert_false(compression_case(id))
  }
  let all_rows = read_rows()
  let window_rows = rows_of(all_rows, "server", "autobahn/direct")
  for id in ["ab-13.3.1", "ab-13.5.18"] {
    let row = decide(window_rows, id).unwrap()
    for
      (marker, fields, expected) in [
        ("UNIMPLEMENTED/OK", "behavior=UNIMPLEMENTED close=OK", 1),
        ("FAILED/OK", "behavior=FAILED close=OK", 0),
        ("UNIMPLEMENTED/FAILED", "behavior=UNIMPLEMENTED close=FAILED", 0),
        ("UNIMPLEMENTED/OK", "behavior=UNIMPLEMENTED", 0),
        ("UNIMPLEMENTED/OK", "behavior=UNIMPLEMENTED close=OK close=FAILED", 0),
      ] {
      let tally = { pass: 0, fail: 0, known: 0, failures: [], }
      tally.report(
        "server",
        "autobahn",
        [row],
        [row],
        "CASE \{id} \{marker} \{fields}",
        "",
        quiet=true,
      )
      assert_eq(tally.known, expected)
      assert_eq(tally.fail, 1 - expected)
    }
  }
  let window_rows = rows_of(all_rows, "client", "native/autobahn")
  for id in ["autobahn-13.3.1", "autobahn-13.5.18", "autobahn-13.7.1"] {
    let row = decide(window_rows, id).unwrap()
    for
      (marker, fields, expected) in [
        ("FAILED/FAILED", "behavior=FAILED close=FAILED", 1),
        ("FAILED/OK", "behavior=FAILED close=OK", 0),
        ("ok", "behavior=OK close=OK", 0),
        ("FAILED/FAILED", "behavior=FAILED", 0),
        ("FAILED/FAILED", "behavior=FAILED close=FAILED close=OK", 0),
      ] {
      let tally = { pass: 0, fail: 0, known: 0, failures: [], }
      tally.report(
        "client",
        "autobahn",
        [row],
        [row],
        "CASE \{id} \{marker} \{fields}",
        "",
        quiet=true,
      )
      assert_eq(tally.known, expected)
      assert_eq(tally.fail, 1 - expected)
    }
  }
  for side in ["server", "client"] {
    for number in ["7.1.6", "7.13.1", "7.13.2"] {
      let id = if side == "server" {
        "ab-\{number}"
      } else {
        "autobahn-\{number}"
      }
      let rows = rows_of(
        all_rows,
        side,
        if side == "server" {
          "autobahn/direct"
        } else {
          "native/autobahn"
        },
      )
      let row = decide(rows, id).unwrap()
      for
        verdicts in [
          "behavior=FAILED close=INFORMATIONAL", "behavior=INFORMATIONAL close=FAILED",
          "behavior=missing close=INFORMATIONAL", "behavior=INFORMATIONAL close=missing",
          "behavior=NON-STRICT close=INFORMATIONAL", "behavior=INFORMATIONAL", "close=INFORMATIONAL",
          "behavior=INFORMATIONAL close=INFORMATIONAL close=FAILED",
        ] {
        let tally = { pass: 0, fail: 0, known: 0, failures: [], }
        tally.report(
          side,
          "autobahn",
          [row],
          [row],
          "CASE \{id} fail \{verdicts}",
          "",
          quiet=true,
        )
        assert_eq(tally.fail, 1, msg="\{side} accepted \{verdicts}")
        assert_eq(tally.known, 0)
      }
      for marker in ["fail", "INFORMATIONAL/INFORMATIONAL"] {
        let tally = { pass: 0, fail: 0, known: 0, failures: [], }
        tally.report(
          side,
          "autobahn",
          [row],
          [row],
          "CASE \{id} \{marker} behavior=INFORMATIONAL close=INFORMATIONAL",
          "",
          quiet=true,
        )
        assert_eq((tally.known, tally.fail), (1, 0))
      }
    }
  }
  let first = autobahn_fixture_dir()
  defer (if @fs.exists(first) { @fs.rmdir(first, recursive=true) })
  let second = autobahn_fixture_dir()
  defer (if @fs.exists(second) { @fs.rmdir(second, recursive=true) })
  assert_true(first != second, msg="Autobahn runs must own separate fixtures")
  @fs.write_text("\{first}/index.json", "first run")
  @fs.write_text("\{second}/index.json", "second run")
  assert_eq(@fs.read_text("\{first}/index.json"), "first run")
  @fs.rmdir(first, recursive=true)
  assert_eq(@fs.read_text("\{second}/index.json"), "second run")
  let fixture = "\{second}/index.json"
  for agent in ["mttp", "mttp-client"] {
    let prefix = if agent == "mttp" { "ab" } else { "autobahn" }
    for
      (fields, pair) in [
        (
          "\"behavior\":\"INFORMATIONAL\",\"behaviorClose\":\"INFORMATIONAL\"", "INFORMATIONAL/INFORMATIONAL",
        ),
        (
          "\"behavior\":\"FAILED\",\"behaviorClose\":\"INFORMATIONAL\"", "FAILED/INFORMATIONAL",
        ),
        (
          "\"behavior\":\"INFORMATIONAL\",\"behaviorClose\":\"FAILED\"", "INFORMATIONAL/FAILED",
        ),
        ("\"behavior\":\"INFORMATIONAL\"", "INFORMATIONAL/missing"),
        ("\"behaviorClose\":\"INFORMATIONAL\"", "missing/INFORMATIONAL"),
        ("", "missing/missing"),
      ] {
      @fs.write_text(fixture, "{\"\{agent}\":{\"7.1.6\":{\{fields}}}}")
      let (status, output, problem) = capture("moon", [
        "run", "interop/clients/autobahn/adapter.mbtx", "--", fixture, agent,
      ])
      assert_eq(status, 0, msg=problem)
      assert_true(
        output.contains("CASE \{prefix}-7.1.6 \{pair} behavior="),
        msg=output,
      )
    }
  }
  println("Autobahn verdict self-tests: OK")
}

///|
async fn autobahn_fixture_dir() -> String {
  @fs.tmpdir(prefix="mttp-autobahn-verdict-fixture")
}

///|
/// Creates directory `path` and its parents unless it is a directory
/// already. `@fs.mkdir`'s flag for that is `allow_exist` on MoonBit 0.10.20
/// and `allow_existing` later; asking first needs neither, and a file in
/// the way still makes `mkdir` fail.
async fn make_dir(path : String) -> Unit {
  if !(@fs.exists(path) && @fs.kind(path) is Directory) {
    @fs.mkdir(path, recursive=true)
  }
}
