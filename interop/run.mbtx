let work : String = "_build/interop"

///|
let server_addr : String = "127.0.0.1:39000"

///|
let native_client : String = "_build/native/debug/build/\{interop_module}/mttp_client/mttp_client.exe"

///|
let native_server : String = "_build/native/debug/build/\{interop_module}/mttp_server/mttp_server.exe"

///|
let openapi_server_addr : String = "127.0.0.1:39040"

///|
let openapi_server : String = "_build/native/debug/build/\{interop_module}/openapi_server/openapi_server.exe"

///|
let js_client_dir : String = "_build/js/debug/build/\{interop_module}/mttp_client"

///|
/// The third-party servers: name (as in images.tsv), plain port (TLS is the
/// next one), the container's mounts and command, and the prefix of the
/// client cases it serves: "" for the full layout interop/mttp_client
/// describes, or a narrower one for a server that serves only some of it,
/// so that a row whose server is `*` does not reach it.
priv struct Server {
  name : String
  port : Int32
  config : (String, String)
  command : Array[String]
  serves : String
}

