import {
  "gaato/mttp_core",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/path",
}

import {
  "gaato/mttp_core/endpoint",
  "gaato/mttp_core/router",
  "gaato/mttp_async/server",
  "moonbitlang/core/async",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/path",
} for "test"

supported_targets = "native+wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async",
    "moonbitlang/core/async/socket",
    "moonbitlang/core/async/cond_var",
  ],
)
