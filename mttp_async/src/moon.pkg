import {
  "gaato/mttp",
  "gaato/mttp/client",
  "gaato/mttp/client/cookies",
  "gaato/mttp/cookie",
  "gaato/mttp/h1client",
  "gaato/mttp/rt",
  "gaato/mttp_async/backend",
  "gaato/mttp_async/runtime",
  "gaato/mttp_async/trust",
  "moonbitlang/core/async",
}

import {
  "gaato/mttp/endpoint",
  "gaato/mttp/router",
  "gaato/mttp/schema",
  "gaato/mttp/testing",
  "gaato/mttp_async/server",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/encoding/utf8",
} for "test"

supported_targets = "js + native + wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/cond_var",
  ],
  targets: { "entry_test.mbt": [ "native", "wasm" ] },
)
