import {
  "gaato/mttp_core",
  "gaato/mttp_core/endpoint",
  "gaato/mttp_core/rt",
  "moonbitlang/core/env",
  "gaato/mttp_core/ws" @core_ws,
  "gaato/mttp_core/ws/handshake",
}

#cfg(target="js")
import {
  "gaato/mttp/fetch",
}

#cfg(not(target="js"))
import {
  "gaato/deflate",
  "gaato/codec_bytes",
  "gaato/mttp/runtime",
}

supported_targets = "native+wasm+js"

import {
  "gaato/mttp_core/ws/handshake",
  "gaato/mttp_core/schema",
  "gaato/mttp_core/router",
  "gaato/mttp_core/endpoint/testkit",
  "gaato/mttp_core/openapi",
  "gaato/mttp_core/apispec",
  "gaato/mttp_core/driver",
  "gaato/mttp_core/sim",
} for "test"

#cfg(not(target="js"))
import {
  "gaato/mttp_core/client",
  "gaato/mttp/backend",
}

import {
  "moonbitlang/core/async",
} for "test"

#cfg(not(target="js"))
import {
  "moonbitlang/core/async/socket",
  "moonbitlang/core/encoding/utf8",
  "gaato/mttp_core/h1client",
  "gaato/mttp/server",
  "gaato/mttp_core/ws/frame",
  "gaato/deflate",
} for "test"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/socket",
    "gaato/mttp_core/driver",
  ],
  targets: {
    "compression.mbt": [ "native", "wasm" ],
    "compression_wbtest.mbt": [ "native", "wasm" ],
    "compression_corpus_wbtest.mbt": [ "native", "wasm" ],
    "compression_corpus_test.mbt": [ "native", "wasm" ],
    "socket_test.mbt": [ "native", "wasm" ],
    "connect_test.mbt": [ "native", "wasm" ],
    "upgrade_cleanup_test.mbt": [ "native", "wasm" ],
    "host.js_test.mbt": [ "js" ],
  },
)
