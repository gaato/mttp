///|
test "map3 preserves order and collects all missing inputs" {
  let input = @endpoint.Input::map3(
    @endpoint.query("q0", @schema.int),
    @endpoint.query("q1", @schema.int),
    @endpoint.query("q2", @schema.int),
    (v0, v1, v2) => [v0, v1, v2],
    values => (values[0], values[1], values[2]),
  )
  let expected = [10, 11, 12]
  let request = @endpoint.endpoint
    .post("/")
    .input(input)
    .request((), expected)
    .raw()
  @driver.run_sync(() => {
    assert_eq(decoded(input, request), expected)
    assert_eq(refused(input, @model.Request::post("/")).length(), 3)
  })
}

