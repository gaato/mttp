import {
  "gaato/mttp_core",
  "gaato/mttp_core/rt",
  "gaato/mttp_core/h1client",
  "gaato/mttp/trust",
  "gaato/mttp/runtime",
}

#cfg(not(target="js"))
import {
  "gaato/mttp/conn",
  "gaato/mttp/codings",
  "moonbitlang/core/env",
}

#cfg(target="js")
import {
  "gaato/mttp_core/h1",
  "moonbitlang/core/async/js_async",
}

import {
  "gaato/mttp_core/sim",
  "moonbitlang/core/async",
} for "test"

#cfg(not(target="js"))
import {
  "moonbitlang/core/encoding/utf8",
  "gaato/mttp_core/h1server",
  "gaato/mttp/internal/socketconn",
  "gaato/mttp/internal/testtls",
  "moonbitlang/core/async/socket",
} for "test"

supported_targets = "native+wasm+js"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/js_async",
    "moonbitlang/core/async/socket",
  ],
  targets: {
    "platform.native.mbt": [ "native", "wasm" ],
    "platform.js.mbt": [ "js" ],
    "fetch_ffi.js.mbt": [ "js" ],
    "fetch_body.js.mbt": [ "js" ],
    "socket_test.mbt": [ "native", "wasm" ],
    "tls_test.mbt": [ "native", "wasm" ],
    "fetch.js_test.mbt": [ "js" ],
  },
)
