import {
  "gaato/mttp_core",
  "gaato/mttp_core/h1",
  "gaato/mttp_core/ws",
  "moonbitlang/core/async",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/async/semaphore",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async/js_async",
}

import {
  "gaato/mttp",
} for "test"

import {
  "gaato/mttp/ws" @facade_ws,
  "gaato/mttp_core/endpoint",
  "gaato/mttp_core/schema",
} for "wbtest"

supported_targets = "js"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/cond_var",
    "moonbitlang/core/async/js_async",
    "moonbitlang/core/async/semaphore",
  ],
)
