/// Compares OpenApi values.
pub extend OpenApi with Eq::{equal, not_equal}

///|
/// Formats OpenApi values.
pub extend OpenApi with @debug.Debug::{to_repr}

///|
/// Serializes OpenApi to a JSON value.
pub extend OpenApi with ToJson::{to_json}

///|
