pub extend Components with ToJson::{to_json}

///|
/// Deserializes Components at a JSON path.
pub extend Components with @json.FromJson::{from_json}

///|
/// OpenAPI 3.1 OpenApi data with flattened x-* extensions.
#derive(Eq, Debug)
pub(all) struct OpenApi {
  info : Info
  paths : Map[String, PathItem]
  openapi : String
  servers : Array[Server]
  components : Components
  tags : Array[Tag]
  extensions : Map[String, Json]
}

///|
/// Creates OpenApi data with defaults for optional fields.
pub fn OpenApi::new(
  info : Info,
  paths : Map[String, PathItem],
  openapi~ : String = "3.1.0",
  servers~ : Array[Server] = [],
  components~ : Components = Components::new(),
  tags~ : Array[Tag] = [],
  extensions~ : Map[String, Json] = {},
) -> OpenApi {
  {
    info,
    paths,
    openapi,
    servers,
    components,
    tags,
    extensions: extensions.copy(),
  }
}

///|
/// Encodes OpenApi, omitting absent optional fields and fields at their
/// empty default.
pub impl ToJson for OpenApi with fn to_json(self) {
  let obj : Map[String, Json] = Map([])
  obj["info"] = Json(self.info)
  obj["paths"] = Json(self.paths)
  obj["openapi"] = Json(self.openapi)
  if !self.servers.is_empty() {
    obj["servers"] = Json(self.servers)
  }
  if self.components != Components::new() {
    obj["components"] = Json(self.components)
  }
  if !self.tags.is_empty() {
    obj["tags"] = Json(self.tags)
  }
  add_extensions(obj, self.extensions)
  Json::object(obj)
}

///|
/// Decodes OpenApi while retaining extension fields.
pub impl @json.FromJson for OpenApi with fn from_json(value, path) {
  let obj = expect_object(value, path)
  {
    info: field(obj, "info", path),
    paths: field(obj, "paths", path),
    openapi: field(obj, "openapi", path, default="3.1.0"),
    servers: field(obj, "servers", path, default=[]),
    components: field(obj, "components", path, default=Components::new()),
    tags: field(obj, "tags", path, default=[]),
    extensions: extension_fields(obj),
  }
}

