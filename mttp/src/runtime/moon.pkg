import {
  "gaato/mttp_core/rt",
  "gaato/mttp_core",
  "moonbitlang/core/async",
  "moonbitlang/core/async/semaphore",
  "moonbitlang/core/async/cond_var",
}

import {
  "moonbitlang/core/async/aqueue",
  "gaato/mttp_core/endpoint",
  "gaato/mttp_core/sim",
  "moonbitlang/core/async/cond_var",
} for "test"

supported_targets = "native + wasm + js"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/semaphore",
    "moonbitlang/core/async/cond_var",
    "moonbitlang/core/async/aqueue",
  ],
)
