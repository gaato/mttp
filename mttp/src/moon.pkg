import {
  "gaato/mttp_core",
  "gaato/mttp_core/client",
  "gaato/mttp_core/cookie",
  "gaato/mttp_core/h1client",
  "gaato/mttp_core/rt",
  "gaato/mttp/backend",
  "gaato/mttp/runtime",
  "gaato/mttp/trust",
  "moonbitlang/core/async",
}

import {
  "gaato/mttp_core/endpoint",
  "gaato/mttp_core/router",
  "gaato/mttp_core/schema",
  "gaato/mttp_core/testing",
  "gaato/mttp/server",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/encoding/utf8",
} for "test"

supported_targets = "js + native + wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/cond_var",
  ],
  targets: { "entry_test.mbt": [ "native", "wasm" ] },
)
