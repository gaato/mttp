import {
  "moonbitlang/core/debug",
  "gaato/mttp_core",
  "gaato/mttp_core/rt",
  "gaato/mttp_core/h1server",
  "gaato/mttp/internal/control",
  "gaato/mttp/internal/socketconn",
  "gaato/mttp/runtime",
  "moonbitlang/core/async",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/cond_var",
}

import {
  "moonbitlang/core/encoding/utf8",
} for "test"

supported_targets = "native+wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/socket",
    "moonbitlang/core/async/cond_var",
  ],
)
