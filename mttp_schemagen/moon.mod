name = "gaato/mttp_schemagen"

version = "0.1.0"

import {
  "moonbitlang/parser@0.4.9",
  "moonbitlang/lexer@0.4.5",
}

license = "Apache-2.0"

source = "src"

readme = "README.md"

repository = "https://github.com/gaato/mttp"

description = "Generate ordinary mttp_core JSON codecs from annotated MoonBit types."

keywords = [ "schema", "json", "openapi", "codegen" ]

preferred_target = "wasm"

supported_targets = "wasm"
