import {
  "gaato/mttp",
  "gaato/codec_bytes",
  "gaato/deflate",
  "gaato/deflate/gzip",
  "gaato/deflate/zlib",
  "gaato/brotli",
  "gaato/zstd",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/async",
  "moonbitlang/core/random",
} for "wbtest"

import {
  "gaato/mttp/driver",
  "gaato/mttp/sim",
} for "test"

supported_targets = "native+wasm+js"

options(
  "allow-experimental-packages": [
    "gaato/mttp/driver",
    "moonbitlang/core/async",
  ],
)
