----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}
----

// Writes the third-party test data of the conformance module as MoonBit test
// files. The sources are pinned in conformance/NOTICE.
//
// Two steps keep the gates offline. An extract step reads a checkout of an
// upstream repository and writes what the tests need; it runs only when a
// pinned source moves:
//
//   moon run scripts/gen_vectors.mbtx -- url <urltestdata.json>
//   moon run scripts/gen_vectors.mbtx -- cookie <parser.ts> <examples.ts> <bsd-examples.ts>
//   moon run scripts/gen_vectors.mbtx -- llhttp <llhttp checkout>
//   moon run scripts/gen_vectors.mbtx -- wpt-fetch <wpt checkout>
//   moon run scripts/gen_vectors.mbtx -- sf <structured-field-tests checkout>
//   moon run scripts/gen_vectors.mbtx -- urlpattern <urlpatterntestdata.json>
//
// `url` and `cookie` write their test files directly, the data as JSON in a
// string, one entry per line: `url` keeps the rows of urltestdata.json whose
// input or result is an http, https, ws or wss URL; `cookie` turns
// tough-cookie's copies of the http-state tests, TypeScript object literals,
// into JSON; `sf` keeps every case of httpwg's structured-field-tests, its
// parsing tests and its serialisation-tests, each with the name of its file;
// `urlpattern` keeps every case of WPT's urlpatterntestdata.json, its lone
// surrogates as U+FFFD (see usv_escapes).
// `llhttp` and `wpt-fetch` copy the upstream cases verbatim into
// conformance/data/: each llhttp test's markdown heading, metadata, input
// block and expected callback log, and the HTTP/1 parsing resources and
// expectation tables of web-platform-tests' fetch/h1-parsing and
// fetch/content-length.
//
// The generate step, run without arguments, turns conformance/data/ into
// conformance/src/http1/*_vectors_test.mbt: it rewrites each input as llhttp's
// test runner does (test/md-test.ts), reads each expectation into the
// outcome mttp's codec gives for it, and moves the cases listed in
// conformance/data/h1_differences.txt into the table of documented
// differences, with their reasons. With `--check` it writes nothing and
// fails if a generated file differs, which the static gates run.
//
// Exit status: 0 = written or up to date, 1 = stale or bad data, 2 = bad usage.

///|
let header : String = "// GENERATED by scripts/gen_vectors.mbtx from the sources in conformance/NOTICE — DO NOT EDIT.\n"

///|
let data_dir : String = "conformance/data"

///|
let h1_dir : String = "conformance/src/http1"

// ---------------------------------------------------------------------------
// url and cookie (extract and write directly)

///|
/// A MoonBit declaration of `name` holding `rows`, one JSON value per line.
fn string_of_rows(name : String, rows : Array[Json]) -> String {
  let out = StringBuilder()
  out.write_string("\n///|\nlet \{name} : String =\n")
  for i, row in rows {
    let separator = if i + 1 < rows.length() { "," } else { "" }
    let opening = if i == 0 { "[" } else { "" }
    out.write_string("  #|\{opening}\{row.stringify()}\{separator}\n")
  }
  if rows.is_empty() {
    out.write_string("  #|[\n")
  }
  out.write_string("  #|]\n")
  out.to_string()
}

///|
fn special_url(text : String) -> Bool {
  let lower = text.trim(chars=" \t\n\r").to_lower()
  ["http:", "https:", "ws:", "wss:"]
  .iter()
  .any(scheme => lower.has_prefix(scheme))
}

///|
fn url_rows(source : String) -> Array[Json] raise {
  guard @json.parse(source) is Array(rows) else { fail("expected an array") }
  rows.filter(row => {
    guard row is Object(fields) else { return false }
    match (fields.get("href"), fields.get("input"), fields.get("base")) {
      (Some(String(href)), _, _) => special_url(href)
      (None, Some(String(input)), Some(Null) | None) => special_url(input)
      (None, Some(String(input)), Some(String(base))) =>
        special_url(input) || special_url(base)
      _ => false
    }
  })
}

///|
/// A JavaScript literal as JSON: unquoted keys quoted, single-quoted strings
/// double-quoted, trailing commas dropped. Escapes in the sources (`\t`,
/// `\uXXXX`, `\\`) mean the same in JSON; `\'` is a quote. Double-quoted
/// strings are copied as they are.
fn js_literal_to_json(text : String) -> Json raise {
  let chars = text.to_array()
  let out = StringBuilder()
  let mut i = 0
  while i < chars.length() {
    let c = chars[i]
    if c == '"' {
      out.write_char('"')
      i += 1
      while chars[i] != '"' {
        if chars[i] == '\\' {
          out.write_char('\\')
          i += 1
        }
        out.write_char(chars[i])
        i += 1
      }
      out.write_char('"')
      i += 1
    } else if c == '\'' {
      out.write_char('"')
      i += 1
      while chars[i] != '\'' {
        if chars[i] == '\\' && chars[i + 1] == '\'' {
          out.write_char('\'')
          i += 2
        } else if chars[i] == '\\' {
          out.write_char('\\')
          out.write_char(chars[i + 1])
          i += 2
        } else {
          if chars[i] == '"' {
            out.write_char('\\')
          }
          out.write_char(chars[i])
          i += 1
        }
      }
      out.write_char('"')
      i += 1
    } else if c.is_ascii_alphabetic() {
      let start = i
      while i < chars.length() &&
            (chars[i].is_ascii_alphabetic() || chars[i] == '-') {
        i += 1
      }
      let word = String::from_array(chars[start:i])
      let mut j = i
      while j < chars.length() && chars[j] is (' ' | '\t') {
        j += 1
      }
      // A key is followed by `:`; `null`, `true` and `false` are values.
      if j < chars.length() && chars[j] == ':' {
        out.write_string("\"\{word}\"")
      } else {
        out.write_string(word)
      }
    } else if c == ',' {
      let mut j = i + 1
      while j < chars.length() && chars[j] is (' ' | '\n' | '\r' | '\t') {
        j += 1
      }
      if j == chars.length() || !(chars[j] is (']' | '}')) {
        out.write_char(',')
      }
      i += 1
    } else {
      out.write_char(c)
      i += 1
    }
  }
  @json.parse(out.to_string())
}

///|
/// A TypeScript `export default` literal as JSON.
fn literal_to_json(source : String) -> Json raise {
  let text = source.trim(chars=" \t\n\r;")
  let text = match text.strip_prefix("export default") {
    Some(rest) => rest.to_owned()
    None => fail("expected `export default`")
  }
  let text = text.trim(chars=" \t\n\r")
  js_literal_to_json(text.strip_suffix("as const").unwrap_or(text).to_owned())
}

///|
fn rows_of(json : Json) -> Array[Json] raise {
  guard json is Array(rows) else { fail("expected an array") }
  rows
}

///|
async fn write_if_changed(target : String, text : String) -> Unit {
  if !@fs.exists(target) || @fs.read_text(target) != text {
    @fs.write_text(target, text)
    println("wrote \{target}")
  } else {
    println("unchanged \{target}")
  }
}

///|
/// `text`, JSON, with each `\\u` escape of a lone surrogate written as
/// `\\uFFFD`. A few urlpattern cases pass lone surrogates, which the
/// standard's USVString arguments turn into U+FFFD before it sees them, and
/// which @json.parse refuses.
fn usv_escapes(text : String) -> String {
  let chars = text.to_array()
  let surrogate = (i : Int32) => {
    guard i + 6 <= chars.length() && chars[i] == '\\' && chars[i + 1] == 'u' else {
      return -1
    }
    let mut v = 0
    for c in chars[i + 2:i + 6] {
      let digit = match c {
        '0'..<='9' => c.to_int() - '0'.to_int()
        'a'..<='f' => c.to_int() - 'a'.to_int() + 10
        'A'..<='F' => c.to_int() - 'A'.to_int() + 10
        _ => return -1
      }
      v = v * 16 + digit
    }
    if v >= 0xD800 && v <= 0xDFFF {
      v
    } else {
      -1
    }
  }
  let out = StringBuilder()
  let mut i = 0
  while i < chars.length() {
    // A backslash escaping a backslash is not the start of an escape.
    if chars[i] == '\\' && i + 1 < chars.length() && chars[i + 1] == '\\' {
      out.write_string("\\\\")
      i += 2
      continue
    }
    let v = surrogate(i)
    if v >= 0xD800 && v <= 0xDBFF && surrogate(i + 6) >= 0xDC00 {
      out.write_string(String::from_array(chars[i:i + 12]))
      i += 12
    } else if v >= 0 {
      out.write_string("\\uFFFD")
      i += 6
    } else {
      out.write_char(chars[i])
      i += 1
    }
  }
  out.to_string()
}

///|
/// httpwg's structured-field-tests in `root`: the cases of each JSON file at
/// the top and in serialisation-tests/, in file name order, each with a
/// "file" member naming its file.
async fn sf_rows(root : String) -> Array[Json] {
  let rows = []
  for dir in ["", "serialisation-tests/"] {
    let names = @fs.readdir(root + "/" + dir)
    // By character, not as String's order sorts (shorter first).
    names.sort_by((a, b) => {
      for i in 0..<a.length().min(b.length()) {
        if a[i] != b[i] {
          return a[i].to_int() - b[i].to_int()
        }
      }
      a.length() - b.length()
    })
    for name in names {
      guard name.has_suffix(".json") else { continue }
      let file = dir + name
      let source = @fs.read_text(root + "/" + file)
      // The numbers as written: 1.0 is a Decimal, 1 an Integer.
      let cases = rows_of(@json.parse(source, preserve_number_repr=true)) catch {
        e => fail("\{file}: \{e}")
      }
      for case in cases {
        guard case is Object(fields) else { fail("\{file}: expected objects") }
        let row : Map[String, Json] = Map([])
        row["file"] = Json::string(file)
        for k, v in fields {
          row[k] = v
        }
        rows.push(Json::object(row))
      }
    }
  }
  rows
}

// ---------------------------------------------------------------------------
// Byte strings. Upstream inputs are bytes; they are kept as strings of the
// code points 0 to 255, one per byte, so JSON can carry any byte.

///|
fn latin1_of_bytes(bytes : BytesView) -> String {
  let out = StringBuilder()
  for byte in bytes {
    out.write_char(byte.to_int().unsafe_to_char())
  }
  out.to_string()
}

///|
fn latin1_of_text(text : StringView) -> String {
  latin1_of_bytes(@utf8.encode(text))
}

///|
/// One line of a vector file: `\\`, `\r`, `\n`, `\t` and `\xHH` for the
/// other bytes outside printable ASCII, as conformance/src/http1 reads them.
fn esc(latin1 : StringView) -> String {
  let out = StringBuilder()
  for c in latin1 {
    let code = c.to_int()
    match c {
      '\\' => out.write_string("\\\\")
      '\r' => out.write_string("\\r")
      '\n' => out.write_string("\\n")
      '\t' => out.write_string("\\t")
      _ if code < 0x20 || code >= 0x7f => {
        let hex = "0123456789abcdef"
        out.write_string("\\x")
        out.write_char(hex.get_char(code / 16 % 16).unwrap())
        out.write_char(hex.get_char(code % 16).unwrap())
      }
      _ => out.write_char(c)
    }
  }
  out.to_string()
}

///|
/// Text with each occurrence of `from` replaced by `to`.
fn replace_all(text : String, from : String, to : String) -> String {
  text.replace_all(old=from, new=to)
}

///|
/// A JSON array with one value per line, so that a changed upstream case
/// shows as one changed line.
fn json_lines(rows : Array[Json]) -> String {
  let out = StringBuilder()
  out.write_string("[\n")
  for i, row in rows {
    out.write_string(row.stringify())
    out.write_string(if i + 1 < rows.length() { ",\n" } else { "\n" })
  }
  out.write_string("]\n")
  out.to_string()
}

// ---------------------------------------------------------------------------
// llhttp: extract

///|
/// The markdown files in the order test/md-test.ts runs them.
fn llhttp_files(md_test : String) -> Array[String] {
  let files = []
  for line in md_test.split("\n") {
    let line = line.trim(chars=" ")
    guard line.strip_prefix("run('") is Some(rest) else { continue }
    guard rest.split_once("'") is Some((name, _)) else { continue }
    if name.has_prefix("request/") || name.has_prefix("response/") {
      files.push(name.to_owned())
    }
  }
  files
}

///|
/// The tests of one llhttp markdown file as mdgator finds them: each
/// heading below the title with a fenced `http` block, the metadata comment
/// before that block, and the `log` block.
fn llhttp_cases(file : String, text : String) -> Array[Json] raise {
  let lines : Array[String] = text.split("\n").map(l => l.to_owned()).collect()
  let cases = []
  let mut name = ""
  let mut heading_line = 0
  let mut depth = 0
  let mut meta : Json? = None
  let mut http_meta : Json = Json::null()
  let mut http : String? = None
  let mut log : String? = None
  fn flush() raise {
    match (http, log) {
      (None, None) => ()
      (Some(input), Some(expected)) =>
        cases.push(
          Json::object({
            "file": Json::string(file),
            "line": Json::number(heading_line.to_double()),
            "name": Json::string(name),
            "meta": http_meta,
            "http": Json::string(input),
            "log": Json::string(expected),
          }),
        )
      _ =>
        fail("\{file}:\{heading_line}: a test needs one http and one log block")
    }
    http = None
    log = None
    http_meta = Json::null()
  }
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    if line.has_prefix("```") {
      let info = line[3:].trim(chars=" ").to_owned()
      let content = StringBuilder()
      i += 1
      while !lines[i].has_prefix("```") {
        content.write_string(lines[i])
        content.write_char('\n')
        i += 1
      }
      guard depth > 1 else { fail("\{file}:\{i}: a block outside a test") }
      match info {
        "http" => {
          guard http is None else { fail("\{file}:\{i}: two http blocks") }
          http = Some(content.to_string())
          http_meta = meta.unwrap_or(Json::null())
          meta = None
        }
        "log" => {
          guard log is None else { fail("\{file}:\{i}: two log blocks") }
          log = Some(content.to_string())
          meta = None
        }
        _ => fail("\{file}:\{i}: unknown block `\{info}`")
      }
    } else if line.has_prefix("#") {
      flush()
      let hashes = line.length() - line.trim_start(chars="#").length()
      depth = hashes
      name = line[hashes:].trim(chars=" ").to_owned()
      heading_line = i + 1
      meta = None
    } else if i + 1 < lines.length() &&
      lines[i + 1] is ['=', ..] &&
      lines[i + 1].trim_end(chars="=") == "" &&
      line != "" {
      flush()
      depth = 1
      name = line
      heading_line = i + 1
      meta = None
      i += 1
    } else if line.strip_prefix("<!-- meta=") is Some(rest) {
      guard rest.strip_suffix("-->") is Some(json) else {
        fail("\{file}:\{i + 1}: unterminated metadata")
      }
      meta = Some(@json.parse(json.to_owned()))
    }
    i += 1
  }
  flush()
  cases
}

///|
async fn extract_llhttp(root : String) -> Unit {
  let files = llhttp_files(@fs.read_text("\{root}/test/md-test.ts"))
  guard !files.is_empty() else { fail("no markdown files in md-test.ts") }
  let rows = []
  for file in files {
    rows.append(llhttp_cases(file, @fs.read_text("\{root}/test/\{file}.md")))
  }
  write_if_changed("\{data_dir}/llhttp.json", json_lines(rows))
}

// ---------------------------------------------------------------------------
// web-platform-tests fetch: extract

///|
/// The response a wptserve handler writes, as literal byte strings around
/// the request's parameter: the `b"..."` literals of the lines that build
/// `output`, and `request.GET.first(...)` where the parameter goes. Fails on
/// any other line that touches `output`, so a changed handler is noticed.
fn handler_template(source : String) -> (String, String) raise {
  let before = StringBuilder()
  let after = StringBuilder()
  let mut seen_input = false
  for line in source.split("\n") {
    guard line.contains("output") && !line.contains("writer.write") else {
      continue
    }
    let chars = line.to_array()
    let mut i = 0
    while i < chars.length() {
      if line[i:].has_prefix("request.GET.first(") {
        guard !seen_input else { fail("two parameters in a handler") }
        seen_input = true
        while chars[i] != ')' {
          i += 1
        }
        i += 1
      } else if chars[i] == 'b' && i + 1 < chars.length() && chars[i + 1] == '"' {
        i += 2
        let out = if seen_input { after } else { before }
        while chars[i] != '"' {
          if chars[i] == '\\' {
            i += 1
            match chars[i] {
              'r' => out.write_char('\r')
              'n' => out.write_char('\n')
              c => fail("unknown escape \\\{c}")
            }
          } else {
            out.write_char(chars[i])
          }
          i += 1
        }
        i += 1
      } else {
        i += 1
      }
    }
  }
  guard seen_input else { fail("no parameter in a handler") }
  (before.to_string(), after.to_string())
}

///|
/// The rows of the `expected` table in h1-parsing.tentative.html:
/// character, position, fetch outcome and framing outcome.
fn h1_parsing_table(html : String) -> Array[Json] raise {
  let rows = []
  let mut char = ""
  let mut inside = false
  for line in html.split("\n") {
    let line = line.trim(chars=" ")
    if line.has_prefix("let expected = {") {
      inside = true
      continue
    }
    guard inside else { continue }
    if line.has_prefix("for (") {
      break
    }
    guard line is ['\'', ..] else { continue }
    let parts : Array[String] = line.split("'").map(p => p.to_owned()).collect()
    if line.has_suffix("{") {
      char = parts[1]
    } else {
      guard parts.length() >= 6 else { fail("unexpected row `\{line}`") }
      rows.push(
        Json::object({
          "char": Json::string(char),
          "position": Json::string(parts[1]),
          "fetch": Json::string(parts[3]),
          "framing": Json::string(parts[5]),
        }),
      )
    }
  }
  rows
}

///|
/// The array literal a `.forEach` in a test script runs over.
fn for_each_array(script : String) -> String raise {
  guard script.find("].forEach") is Some(end) else { fail("no forEach") }
  guard script.find("[") is Some(start) else { fail("no array") }
  script[start:end + 1].to_owned()
}

///|
async fn extract_wpt_fetch(root : String) -> Unit {
  let h1 = "\{root}/fetch/h1-parsing"
  let rows = []
  // Every row names its table and file, one per line.
  fn add(table : String, source : String, fields : Map[String, Json]) {
    fields["table"] = Json::string(table)
    fields["source"] = Json::string(source)
    rows.push(Json::object(fields))
  }
  let html = "fetch/h1-parsing/h1-parsing.tentative.html"
  for row in h1_parsing_table(@fs.read_text("\{root}/\{html}")) {
    guard row
      is Object({ "char": String(c), "position": String(p), .. } as fields) else {
      fail("bad h1-parsing row")
    }
    let path = "fetch/h1-parsing/resources/parsing_\{c}_\{p}.asis"
    fields["file"] = Json::string(path)
    fields["bytes"] = Json::string(
      latin1_of_bytes(@fs.read_binary("\{root}/\{path}")),
    )
    add("h1-parsing", html, fields)
  }
  let nul_asis = "fetch/h1-parsing/resources/blue-with-0x00-in-a-header.asis"
  add("nul-in-header", nul_asis, {
    "bytes": Json::string(
      latin1_of_bytes(@fs.read_binary("\{root}/\{nul_asis}")),
    ),
  })
  let handler = "fetch/h1-parsing/resources/status-code.py"
  let (prefix, suffix) = handler_template(@fs.read_text("\{root}/\{handler}"))
  add("status-code-handler", handler, {
    "prefix": Json::string(prefix),
    "suffix": Json::string(suffix),
  })
  let script = "fetch/h1-parsing/status-code.window.js"
  for
    row in rows_of(
      js_literal_to_json(for_each_array(@fs.read_text("\{root}/\{script}"))),
    ) {
    guard row is Object(fields) else { fail("bad status-code row") }
    add("status-code", script, fields)
  }
  let message = @fs.read_text("\{h1}/resources/message.py")
  guard message.contains(
    "response.writer.write(request.GET.first(b\"message\"))",
  ) else {
    fail("message.py no longer writes the message as it is")
  }
  let script = "fetch/h1-parsing/lone-cr.window.js"
  for
    message in rows_of(
      @json.parse(for_each_array(@fs.read_text("\{root}/\{script}"))),
    ) {
    add("lone-cr", script, { "message": message })
  }
  let handler = "fetch/content-length/resources/content-length.py"
  let (prefix, suffix) = handler_template(@fs.read_text("\{root}/\{handler}"))
  add("content-length-handler", handler, {
    "prefix": Json::string(prefix),
    "suffix": Json::string(suffix),
  })
  let lengths = "fetch/content-length/resources/content-lengths.json"
  for row in rows_of(@json.parse(@fs.read_text("\{root}/\{lengths}"))) {
    guard row is Object(fields) else { fail("bad content-lengths row") }
    add("content-lengths", lengths, fields)
  }
  let duplicates = "fetch/content-length/resources/identical-duplicates.asis"
  add("identical-duplicates", duplicates, {
    "bytes": Json::string(
      latin1_of_bytes(@fs.read_binary("\{root}/\{duplicates}")),
    ),
  })
  write_if_changed("\{data_dir}/wpt-fetch.json", json_lines(rows))
}

// ---------------------------------------------------------------------------
// Generate: the outcome model shared with conformance/src/http1/reader_test.mbt.
//
// A reading is one line per fact, in order: for each message its start line
// (`request <method> <target> <version>` or `response <status> <version>`),
// `header <lowercase name>: <value>` per field, `body <payload>` when there
// is one, `trailer <name>: <value>` per trailer field, then `complete`, or
// `incomplete` when the input ends inside it (a message that never got its
// head is only `incomplete`). The reading ends with `refused <ParseKind>`
// (the message being read is dropped), `handoff` (the bytes after a CONNECT
// or an upgrade are not HTTP) or `closed` (bytes after `Connection: close`
// are not read), or with nothing when the input is used up.

///|
struct Case {
  id : String
  name : String
  side : String
  wire : String
  expect : Array[String]
  notes : Array[String]
}

///|
struct Diff {
  expect : Array[String]
  reason : String
  kind_only : Bool
  mut used : Bool
}

///|
/// conformance/data/h1_differences.txt: `reason <text>` lines, each applying
/// to the entries after it, and entries `diff <id> => <line> ; <line>` (mttp
/// accepts or refuses where the source does not) or `kind <id> => refused
/// <Kind>` (both refuse; this names mttp's kind where the default mapping
/// of the source's error does not).
fn differences(text : String) -> Map[String, Diff] raise {
  let diffs : Map[String, Diff] = Map([])
  let mut reason = ""
  for line in text.split("\n") {
    if line is "" || line.has_prefix("#") {
      continue
    }
    if line.strip_prefix("reason ") is Some(r) {
      reason = r.to_owned()
      continue
    }
    let (kind_only, rest) = match
      (line.strip_prefix("diff "), line.strip_prefix("kind ")) {
      (Some(rest), _) => (false, rest)
      (_, Some(rest)) => (true, rest)
      _ => fail("bad differences line `\{line}`")
    }
    guard rest.split_once(" => ") is Some((id, lines)) else {
      fail("bad differences line `\{line}`")
    }
    guard reason != "" else { fail("an entry before any reason: `\{line}`") }
    let id = id.to_owned()
    guard !diffs.contains(id) else { fail("\{id} listed twice") }
    diffs[id] = {
      expect: lines.split(" ; ").map(l => l.to_owned()).collect(),
      reason,
      kind_only,
      used: false,
    }
  }
  diffs
}

///|
/// Version text as mttp reports it: 1.0, or 1.1 for every later HTTP/1
/// minor version (h1 README, "What is refused").
fn version(major : Int32, minor : Int32) -> String {
  match (major, minor) {
    (1, 0) => "1.0"
    (1, _) => "1.1"
    _ => "\{major}.\{minor}"
  }
}

// ---------------------------------------------------------------------------
// Generate: llhttp

///|
/// The input as test/md-test.ts gives it to the parser: the block's last
/// newline removed, escaped newlines joined, newlines made CRLF, then the
/// escapes `\r`, `\n`, `\t`, `\f`, `\xH...` and `\ooo` replaced. The test
/// binary receives it as a command-line argument, so its bytes are the
/// UTF-8 encoding of that text.
fn llhttp_input(block : String) -> String {
  let text = block.strip_suffix("\n").unwrap_or(block).to_owned()
  let text = text
    |> replace_all("\\\r\n", "")
    |> replace_all("\\\r", "")
    |> replace_all("\\\n", "")
    |> replace_all("\r\n", "\n")
    |> replace_all("\r", "\n")
    |> replace_all("\n", "\r\n")
    |> replace_all("\\r", "\r")
    |> replace_all("\\n", "\n")
    |> replace_all("\\t", "\t")
    |> replace_all("\\f", "\u{0c}")
  let text = replace_numeric(text, 'x')
  let text = replace_numeric(text, 'o')
  latin1_of_text(text)
}

///|
/// `\x` followed by hex digits (as many as follow, like the runner's
/// regular expression), or `\` and one to three octal digits, replaced by
/// the UTF-16 code unit they name.
fn replace_numeric(text : String, mode : Char) -> String {
  let chars = text.to_array()
  let out = StringBuilder()
  let mut i = 0
  while i < chars.length() {
    if chars[i] == '\\' &&
      mode == 'x' &&
      i + 2 < chars.length() &&
      chars[i + 1] == 'x' &&
      chars[i + 2].is_ascii_hexdigit() {
      let mut j = i + 2
      let mut value = 0
      while j < chars.length() && chars[j].is_ascii_hexdigit() {
        let d = chars[j].to_int()
        let digit = if d <= '9'.to_int() {
          d - '0'.to_int()
        } else {
          (d | 0x20) - 'a'.to_int() + 10
        }
        value = (value * 16 + digit) & 0xffff
        j += 1
      }
      out.write_char(value.unsafe_to_char())
      i = j
    } else if chars[i] == '\\' &&
      mode == 'o' &&
      i + 1 < chars.length() &&
      chars[i + 1] is ('0'..<='7') {
      let mut j = i + 1
      let mut value = 0
      while j < chars.length() && j < i + 4 && chars[j] is ('0'..<='7') {
        value = value * 8 + (chars[j].to_int() - '0'.to_int())
        j += 1
      }
      out.write_char(value.unsafe_to_char())
      i = j
    } else {
      out.write_char(chars[i])
      i += 1
    }
  }
  out.to_string()
}

///|
struct Msg {
  mut meth : String
  mut url : String
  mut status : String
  mut major : Int32
  mut minor : Int32
  mut protocol : String
  mut version : String
  mut version_end : Int32
  mut head_done : Bool
  mut complete : Bool
  headers : Array[(String, String)]
  trailers : Array[(String, String)]
  body : StringBuilder
}

///|
fn Msg::new() -> Msg {
  {
    meth: "",
    url: "",
    status: "",
    major: 0,
    minor: 0,
    protocol: "",
    version: "",
    version_end: -1,
    head_done: false,
    complete: false,
    headers: [],
    trailers: [],
    body: StringBuilder(),
  }
}

///|
/// What one llhttp log says: the messages in order and how the log ends.
struct Log {
  msgs : Array[Msg]
  mut error : (Int32, String)?
  mut paused : Bool
}

///|
fn field_value(text : String, key : String) -> String {
  for part in text.split(" ") {
    if part.strip_prefix(key + "=") is Some(value) {
      return value.to_owned()
    }
  }
  ""
}

///|
fn parse_log(text : String) -> Log raise {
  let text = text |> replace_all("\\t", "\t") |> replace_all("\\f", "\u{0c}")
  let log = { msgs: [], error: None, paused: false, }
  let field = StringBuilder()
  let value = StringBuilder()
  let mut last_span = ""
  for line in text.split("\n") {
    guard line.strip_prefix("off=") is Some(line) else { continue }
    guard line.split_once(" ") is Some((off, event)) else { continue }
    let off = @string.parse_int(off) catch { _ => -1 }
    let event = event.to_owned()
    if event == "message begin" {
      log.msgs.push(Msg::new())
      continue
    }
    guard log.msgs.last() is Some(msg) else {
      if event.has_prefix("error ") {
        log.error = Some(error_of(event))
      }
      continue
    }
    if event.strip_prefix("len=") is Some(span) {
      guard span.split_once(" span[") is Some((_, span)) else { continue }
      guard span.split_once("]=") is Some((name, raw)) else {
        fail("bad span `\{line}`")
      }
      let text = match raw {
        "cr" => "\r"
        "lf" => "\n"
        _ => {
          guard raw.strip_prefix("\"") is Some(r) &&
            r.strip_suffix("\"") is Some(r) else {
            fail("bad span `\{line}`")
          }
          latin1_of_text(r)
        }
      }
      let name = name.to_owned()
      match name {
        "method" => msg.meth += text
        "url" => msg.url += text
        "protocol" => msg.protocol += text
        "version" => msg.version += text
        "header_field" => {
          if last_span == "header_value" {
            // A value without its complete event; not seen upstream.
            fail("value without complete at `\{line}`")
          }
          field.write_string(text)
        }
        "header_value" => value.write_string(text)
        "body" => msg.body.write_string(text)
        _ => ()
      }
      last_span = name
    } else if event == "header_value complete" {
      // llhttp's span keeps the whitespace after the value, which RFC 9112
      // section 5 leaves out of the field value, as mttp does.
      let pair = (
        field.to_string(),
        value.to_string().trim(chars=" \t").to_owned(),
      )
      if msg.head_done {
        msg.trailers.push(pair)
      } else {
        msg.headers.push(pair)
      }
      field.reset()
      value.reset()
      last_span = ""
    } else if event == "version complete" {
      msg.version_end = off
    } else if event.has_prefix("headers complete ") {
      msg.head_done = true
      let v = field_value(event, "v")
      guard v.split_once("/") is Some((major, minor)) else {
        fail("bad version in `\{line}`")
      }
      msg.major = @string.parse_int(major)
      msg.minor = @string.parse_int(minor)
      msg.status = field_value(event, "status")
      // A header field cut off by the end of the head, as in an error.
      field.reset()
      value.reset()
    } else if event == "message complete" {
      msg.complete = true
    } else if event.has_prefix("error ") {
      log.error = Some(error_of(event))
    } else if event.has_prefix("pause") {
      log.paused = true
    }
  }
  log
}

///|
fn error_of(event : String) -> (Int32, String) {
  let code = @string.parse_int(field_value(event, "code")) catch { _ => -1 }
  let reason = match event.split_once("reason=") {
    Some((_, r)) => r.to_owned()
    None => ""
  }
  (code, reason)
}

///|
/// llhttp's error as the `ParseKind` mttp refuses with: framing that
/// conflicts between Content-Length and Transfer-Encoding is smuggling,
/// everything else malformed. h1_differences.txt names the exceptions.
fn kind_of(error : (Int32, String)) -> String {
  let (_, reason) = error
  if reason.contains("can't be present with") {
    "Smuggling"
  } else {
    "Malformed"
  }
}

///|
fn render_message(out : Array[String], msg : Msg, side : String) -> Unit {
  if side == "request" {
    out.push(
      "request \{msg.meth} \{esc(msg.url)} \{version(msg.major, msg.minor)}",
    )
  } else {
    out.push("response \{msg.status} \{version(msg.major, msg.minor)}")
  }
  for pair in msg.headers {
    out.push("header \{pair.0.to_lower()}: \{esc(pair.1)}")
  }
  let body = msg.body.to_string()
  if body != "" {
    out.push("body \{esc(body)}")
  }
  for pair in msg.trailers {
    out.push("trailer \{pair.0.to_lower()}: \{esc(pair.1)}")
  }
}

///|
/// llhttp's expectation as a reading, and the input with `Host: h` added to
/// every HTTP/1.1 request that has none: RFC 9112 section 3.2 makes a
/// server refuse such a request, which llhttp, a parser only, does not
/// check, so the field is added to test what the case is about. It goes
/// right after the request line, at the offset the log gives for it.
fn llhttp_expectation(
  log : Log,
  side : String,
  input : String,
) -> (Array[String], String) {
  let mut wire = input
  let inserts = []
  for msg in log.msgs {
    if side == "request" &&
      msg.protocol == "HTTP" &&
      msg.version == "1.1" &&
      msg.version_end >= 0 &&
      input.get_view(start=msg.version_end, end=msg.version_end + 2)
      is Some("\r\n") &&
      !msg.headers.iter().any(p => p.0.to_lower() == "host") {
      inserts.push(msg.version_end + 2)
      msg.headers.insert(0, ("Host", "h"))
    }
  }
  for at in inserts.rev() {
    wire = wire[:at].to_owned() + "Host: h\r\n" + wire[at:].to_owned()
  }
  let out = []
  for i, msg in log.msgs {
    let last = i + 1 == log.msgs.length()
    if msg.complete {
      render_message(out, msg, side)
      out.push("complete")
    } else if last && log.error is Some((code, _)) && code != 5 && code != 22 {
      // The message being read when the error came is dropped.
      ()
    } else if msg.head_done {
      render_message(out, msg, side)
      out.push("incomplete")
    } else {
      out.push("incomplete")
    }
  }
  match log.error {
    Some((22, _)) => out.push("handoff")
    Some((5, _)) => out.push("closed")
    Some(error) => out.push("refused \{kind_of(error)}")
    None => ()
  }
  (out, wire)
}

///|
/// Why a case is not imported, or None.
fn llhttp_skip(meta : Map[String, Json], log : Log, input : String) -> String? {
  let ty = match meta.get("type") {
    Some(String(t)) => t
    _ => ""
  }
  if meta.contains("pause") || log.paused {
    Some("pause callbacks, which mttp's codec has no equivalent for")
  } else if meta.contains("skipBody") {
    Some(
      "a callback that skips the body, which mttp's codec has no equivalent for",
    )
  } else if ty.has_suffix("-finish") {
    Some(
      "llhttp_finish, the end-of-input call; mttp's engines own end of input",
    )
  } else if log.error is Some((23, _)) {
    Some("the HTTP/2 connection preface")
  } else if log.msgs.iter().any(m => m.protocol is ("RTSP" | "ICE")) ||
    (
      log.error is Some((_, reason)) &&
      (reason.contains("RTSP") || reason.contains("ICE"))
    ) ||
    input.has_prefix("SOURCE ") {
    Some("RTSP, ICE and Icecast SOURCE, which are not HTTP")
  } else {
    None
  }
}

///|
fn generate_llhttp(
  rows : Array[Json],
  diffs : Map[String, Diff],
) -> String raise {
  let cases = []
  let different = []
  let skipped : Map[String, Int32] = Map([])
  for row in rows {
    guard row
      is {
        "file": String(file),
        "line": Number(line, ..),
        "name": String(name),
        "meta": meta,
        "http": String(http),
        "log": String(log_text),
        ..
      } else {
      fail("bad llhttp row")
    }
    let meta = match meta {
      Object(m) => m
      _ => Map([])
    }
    let id = "llhttp \{file}.md:\{line.to_int()}"
    let ty = match meta.get("type") {
      Some(String(t)) => t
      _ => fail("\{id}: no type")
    }
    let side = if ty.has_prefix("request") { "request" } else { "response" }
    let input = llhttp_input(http)
    let log = parse_log(log_text)
    if llhttp_skip(meta, log, input) is Some(reason) {
      skipped[reason] = skipped.get(reason).unwrap_or(0) + 1
      guard !diffs.contains(id) else { fail("\{id} is skipped and listed") }
      continue
    }
    let (expect, wire) = llhttp_expectation(log, side, input)
    let notes = []
    if wire != input {
      notes.push("Host: h added after the request line")
    }
    if ty != "request" && ty != "response" {
      notes.push("llhttp mode \{ty}")
    }
    let case_ = { id, name, side, wire, expect, notes, }
    place(case_, diffs, cases, different)
  }
  render_tables("llhttp", cases, different, skipped)
}

///|
/// Puts a case in the main table or, when h1_differences.txt lists it, in
/// the table of differences (or the main table with mttp's kind).
fn place(
  case_ : Case,
  diffs : Map[String, Diff],
  cases : Array[(Case, Diff?)],
  different : Array[(Case, Diff)],
) -> Unit raise {
  match diffs.get(case_.id) {
    None => cases.push((case_, None))
    Some(diff) => {
      diff.used = true
      if diff.kind_only {
        let n = case_.expect.length()
        guard n > 0 &&
          case_.expect[n - 1].has_prefix("refused ") &&
          diff.expect.length() == 1 &&
          diff.expect[0].has_prefix("refused ") else {
          fail("\{case_.id}: a kind entry needs a refusal on both sides")
        }
        let expect = case_.expect.copy()
        expect[n - 1] = diff.expect[0]
        cases.push(({ ..case_, expect, }, Some(diff)))
      } else {
        guard diff.expect != case_.expect else {
          fail(
            "\{case_.id}: listed as a difference but mttp's reading is the source's",
          )
        }
        different.push((case_, diff))
      }
    }
  }
}

///|
fn write_case(
  out : StringBuilder,
  case_ : Case,
  upstream~ : Array[String]? = None,
  reason? : String,
) -> Unit {
  out.write_string("  #|case \{case_.id}\n")
  out.write_string("  #|name \{esc(latin1_of_text(case_.name))}\n")
  out.write_string("  #|side \{case_.side}\n")
  out.write_string("  #|wire \{esc(case_.wire)}\n")
  for note in case_.notes {
    out.write_string("  #|note \{note}\n")
  }
  if reason is Some(reason) {
    out.write_string("  #|reason \{reason}\n")
  }
  for line in case_.expect {
    out.write_string("  #|expect \{line}\n")
  }
  if upstream is Some(lines) {
    for line in lines {
      out.write_string("  #|upstream \{line}\n")
    }
  }
}

///|
fn render_tables(
  name : String,
  cases : Array[(Case, Diff?)],
  different : Array[(Case, Diff)],
  skipped : Map[String, Int32],
) -> String {
  let out = StringBuilder()
  out.write_string(header)
  out.write_string(
    "\n///|\n/// Cases read as the source expects, one block per case.\nlet \{name}_cases : String =\n",
  )
  for item in cases {
    let (case_, kind) = item
    match kind {
      Some(diff) =>
        write_case(out, {
          ..case_,
          notes: [..case_.notes, "kind: \{diff.reason}"],
        })
      None => write_case(out, case_)
    }
  }
  out.write_string("  #|\n")
  out.write_string(
    "\n///|\n/// Cases where mttp's documented strictness gives another reading than\n/// the source's, which is kept as `upstream`.\nlet \{name}_differences : String =\n",
  )
  for item in different {
    let (case_, diff) = item
    write_case(
      out,
      { ..case_, expect: diff.expect, },
      upstream=Some(case_.expect),
      reason=diff.reason,
    )
  }
  out.write_string("  #|\n")
  out.write_string(
    "\n///|\n/// Upstream cases not imported, by reason.\nlet \{name}_skipped : String =\n",
  )
  let reasons = skipped.to_array()..sort_by((a, b) => a.0.compare(b.0))
  for item in reasons {
    out.write_string("  #|\{item.1} \{item.0}\n")
  }
  out.write_string("  #|\n")
  out.to_string()
}

// ---------------------------------------------------------------------------
// Generate: web-platform-tests fetch

///|
/// The rows of one table of wpt-fetch.json, as the fields of the first row
/// with every row under `rows`.
fn wpt_table(rows : Array[Json], table : String) -> Map[String, Json] raise {
  let matching = rows.filter(row => {
    row is { "table": String(t), .. } && t == table
  })
  guard matching is [Object(first), ..] else { fail("no \{table} table") }
  let fields = first.copy()
  fields["rows"] = Json::array(matching)
  fields
}

///|
fn quoted(text : String) -> String {
  Json::string(text).stringify()
}

///|
fn generate_wpt(rows : Array[Json], diffs : Map[String, Diff]) -> String raise {
  let cases = []
  let different = []
  let skipped : Map[String, Int32] = Map([])
  // h1-parsing: the character at the position, and what fetch and framing
  // see. A network error is a refusal; otherwise the response is read with
  // X-Frame-Options intact (active-XFO) or as the bytes left it (no-XFO).
  guard wpt_table(rows, "h1-parsing") is { "rows": Array(parsing), .. } else {
    fail("h1-parsing")
  }
  for row in parsing {
    guard row
      is {
        "char": String(c),
        "position": String(p),
        "fetch": String(fetch),
        "framing": String(framing),
        "bytes": String(bytes),
        ..
      } else {
      fail("bad h1-parsing row")
    }
    let symbol = match c {
      "LF" => "\n"
      "CR" => "\r"
      "HTAB" => "\t"
      "SP" => " "
      "NUL" => "\u{0}"
      "COLON" => ":"
      _ => fail("unknown character \{c}")
    }
    let expect = match (fetch, framing) {
      ("Network Error", "Network Error") => ["refused Malformed"]
      ("Valid", "active-XFO" | "no-XFO") => {
        let xfo = if p == "in-value" { "DE\{symbol}NY" } else { "DENY" }
        guard (xfo == "DENY") == (framing == "active-XFO") else {
          fail("\{c} \{p}: framing \{framing} for X-Frame-Options \{xfo}")
        }
        [
          "response 200 1.1",
          "header x-frame-options: \{esc(xfo)}",
          "header content-length: 5",
          "body Test.",
          "complete",
        ]
      }
      _ => fail("\{c} \{p}: unknown outcome \{fetch} \{framing}")
    }
    place(
      {
        id: "wpt h1-parsing \{c} \{p}",
        name: "\{c} at <\{p}>",
        side: "response",
        wire: bytes,
        expect,
        notes: [],
      },
      diffs,
      cases,
      different,
    )
  }
  guard wpt_table(rows, "nul-in-header") is { "bytes": String(bytes), .. } else {
    fail("nul-in-header")
  }
  place(
    {
      id: "wpt h1-parsing blue-with-0x00-in-a-header",
      name: "image with 0x00 in a header",
      side: "response",
      wire: bytes,
      expect: ["refused Malformed"],
      notes: [],
    },
    diffs,
    cases,
    different,
  )
  // The same 0x00 field from two Python handlers, whose response wptserve
  // writes itself.
  skipped["responses that wptserve writes, not the test data"] = 2
  // status-code: the handler writes `HTTP/1.1 <input>`, bare LF line ends
  // and no empty line, and closes; fetch reads the head to the end of the
  // connection. The import ends lines with CRLF and adds the empty line, so
  // the rows test the status line, as they are meant to.
  guard wpt_table(rows, "status-code-handler")
    is { "prefix": String(prefix), "suffix": String(suffix), .. } else {
    fail("status-code-handler")
  }
  guard wpt_table(rows, "status-code") is { "rows": Array(status_rows), .. } else {
    fail("status-code")
  }
  for row in status_rows {
    guard row is { "input": String(input), "expected": expected, .. } else {
      fail("bad status-code row")
    }
    let wire = replace_all(prefix + input + suffix, "\n", "\r\n") + "\r\n"
    let expect = match expected {
      Null => ["refused Malformed"]
      { "status": Number(status, ..), .. } =>
        [
          "response \{status.to_int()} 1.1",
          "header header-parsing: is sad",
          "incomplete",
        ]
      _ => fail("bad status-code row")
    }
    place(
      {
        id: "wpt status-code \{quoted(input)}",
        name: "HTTP/1.1 \{input}",
        side: "response",
        wire,
        expect,
        notes: ["CRLF line ends and the empty line added"],
      },
      diffs,
      cases,
      different,
    )
  }
  // lone-cr: every message is a network error.
  guard wpt_table(rows, "lone-cr") is { "rows": Array(messages), .. } else {
    fail("lone-cr")
  }
  for i, message in messages {
    guard message is { "message": String(message), .. } else {
      fail("bad lone-cr row")
    }
    place(
      {
        id: "wpt lone-cr \{i + 1}",
        name: esc(message),
        side: "response",
        wire: message,
        expect: ["refused Malformed"],
        notes: [],
      },
      diffs,
      cases,
      different,
    )
  }
  // content-lengths: the field lines between the handler's fixed head and
  // its 42-byte body, then the connection closes. `output` is the length of
  // the body fetch reads, or null for a network error. A length fetch
  // accepts frames the body; when fetch ignores the field, the body runs to
  // the close.
  guard wpt_table(rows, "content-length-handler")
    is { "prefix": String(prefix), "suffix": String(suffix), .. } else {
    fail("content-length-handler")
  }
  guard wpt_table(rows, "content-lengths") is { "rows": Array(lengths), .. } else {
    fail("content-lengths")
  }
  guard suffix.strip_prefix("\r\n\r\n") is Some(content) else {
    fail("content-length.py no longer ends the head before its body")
  }
  let content = content.to_owned()
  for i, row in lengths {
    guard row is { "input": String(input), "output": output, .. } else {
      fail("bad content-lengths row")
    }
    let wire = prefix + input + suffix
    let fields = []
    for line in prefix.split("\r\n") {
      if line.split_once(": ") is Some((n, v)) {
        fields.push("header \{n.to_lower()}: \{esc(v)}")
      }
    }
    let values = []
    for line in input.split("\r\n") {
      guard line.split_once(":") is Some((_, v)) else {
        fail("bad content-lengths input")
      }
      let v = v.trim(chars=" \t").to_owned()
      fields.push("header content-length: \{esc(v)}")
      for element in v.split(",") {
        values.push(element.trim(chars=" \t").to_owned())
      }
    }
    let expect = match output {
      Null => ["refused Malformed"]
      Number(n, ..) => {
        let n = n.to_int()
        let first = values[0]
        let framed = values.iter().all(v => v == first) &&
          first != "" &&
          first.iter().all(c => c.is_ascii_digit())
        if framed {
          [
            "response 200 1.1",
            ..fields,
            "body \{esc(content[:n].to_owned())}",
            "complete",
            ..if n < content.length() {
              ["closed"]
            } else {
              []
            },
          ]
        } else {
          ["response 200 1.1", ..fields, "body \{esc(content)}", "incomplete"]
        }
      }
      _ => fail("bad content-lengths output")
    }
    place(
      {
        id: "wpt content-length \{i + 1}",
        name: esc(input),
        side: "response",
        wire,
        expect,
        notes: [],
      },
      diffs,
      cases,
      different,
    )
  }
  skipped["a body shorter than its Content-Length, an end-of-input error mttp's engines report"] = 1
  guard wpt_table(rows, "identical-duplicates")
    is { "bytes": String(bytes), .. } else {
    fail("identical-duplicates")
  }
  place(
    {
      id: "wpt content-length identical-duplicates",
      name: "duplicate Content-Length and Content-Type",
      side: "response",
      wire: bytes,
      expect: [
        "response 200 1.1", "header test: x", "header test: x", "header content-type: text/plain",
        "header content-type: text/plain", "header content-length: 6", "header content-length: 6",
        "body Test.\\n", "complete",
      ],
      notes: [],
    },
    diffs,
    cases,
    different,
  )
  render_tables("wpt", cases, different, skipped)
}

///|
async fn read_rows(path : String) -> Array[Json] {
  rows_of(@json.parse(@fs.read_text(path)))
}

///|
async fn generate() -> Array[(String, String)] {
  let diffs = differences(@fs.read_text("\{data_dir}/h1_differences.txt"))
  let llhttp = generate_llhttp(read_rows("\{data_dir}/llhttp.json"), diffs)
  let wpt = generate_wpt(read_rows("\{data_dir}/wpt-fetch.json"), diffs)
  for id, diff in diffs {
    guard diff.used else {
      fail("h1_differences.txt lists \{id}, which no case has")
    }
  }
  [
    ("\{h1_dir}/llhttp_vectors_test.mbt", llhttp),
    ("\{h1_dir}/wpt_vectors_test.mbt", wpt),
  ]
}

///|
async fn main {
  let args = @env.args()[1:].to_owned()
  match args {
    [] =>
      for item in generate() {
        write_if_changed(item.0, item.1)
      }
    ["--check"] => {
      let mut stale = false
      for item in generate() {
        let (target, text) = item
        let current = @fs.read_text(target) catch { _ => "" }
        if current != text {
          eprintln(
            "\{target} is stale: run 'moon run scripts/gen_vectors.mbtx'",
          )
          stale = true
        }
      }
      if stale {
        @env.exit(1)
      }
    }
    ["url", source] => {
      let rows = url_rows(@fs.read_text(source))
      write_if_changed(
        "conformance/src/url/urltestdata_test.mbt",
        header + string_of_rows("urltestdata", rows),
      )
    }
    ["cookie", parser, examples, bsd_examples] => {
      let text = header +
        string_of_rows(
          "parser_tests",
          rows_of(literal_to_json(@fs.read_text(parser))),
        ) +
        string_of_rows(
          "date_examples",
          rows_of(literal_to_json(@fs.read_text(examples))),
        ) +
        string_of_rows(
          "date_bsd_examples",
          rows_of(literal_to_json(@fs.read_text(bsd_examples))),
        )
      write_if_changed("conformance/src/cookie/http_state_test.mbt", text)
    }
    ["sf", root] =>
      write_if_changed(
        "conformance/src/sf/structured_field_tests_test.mbt",
        header + string_of_rows("structured_field_tests", sf_rows(root)),
      )
    ["urlpattern", source] =>
      write_if_changed(
        "conformance/src/urlpattern/urlpatterntestdata_test.mbt",
        header +
        string_of_rows(
          "urlpatterntestdata",
          rows_of(@json.parse(usv_escapes(@fs.read_text(source)))),
        ),
      )
    ["llhttp", root] => extract_llhttp(root)
    ["wpt-fetch", root] => extract_wpt_fetch(root)
    _ => {
      eprintln(
        "usage: moon run scripts/gen_vectors.mbtx -- [--check] | url <urltestdata.json> | cookie <parser.ts> <examples.ts> <bsd-examples.ts> | llhttp <checkout> | wpt-fetch <checkout> | sf <checkout> | urlpattern <urlpatterntestdata.json>",
      )
      @env.exit(2)
    }
  }
}
