----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}
----

// Writes mttp_core/src/urlpattern/identifier_table.mbt: the code point
// ranges of Unicode's ID_Start and ID_Continue, which the URL Pattern
// Standard's group names are made of (ECMAScript's IdentifierStart and
// IdentifierPart). They come from DerivedCoreProperties.txt of the Unicode
// version the generated file names; to move to another version, run this
// on that version's file:
//
//   curl -O https://www.unicode.org/Public/18.0.0/ucd/DerivedCoreProperties.txt
//   moon run scripts/gen_identifier_tables.mbtx -- DerivedCoreProperties.txt
//
// It needs the file, so the gates do not rerun it.
//
// Exit status: 0 = written or up to date, 1 = bad data, 2 = bad usage.

///|
let target : String = "mttp_core/src/urlpattern/identifier_table.mbt"

///|
/// The ranges of `property` in `source`, sorted and merged.
fn ranges(source : String, property : String) -> Array[(Int32, Int32)] raise {
  let found = []
  for line in source.split("\n") {
    let line = match line.find("#") {
      Some(i) => line[:i]
      None => line
    }
    guard line.split(";").map(f => f.trim(chars=" ").to_owned()).collect()
      is [codes, prop] else {
      continue
    }
    guard prop == property else { continue }
    let (lo, hi) = match codes.split("..").collect() {
      [a] => (@string.parse_int(a, base=16), @string.parse_int(a, base=16))
      [a, b] => (@string.parse_int(a, base=16), @string.parse_int(b, base=16))
      _ => fail("bad line \{line}")
    }
    found.push((lo, hi))
  }
  found.sort_by((a, b) => a.0 - b.0)
  let merged : Array[(Int32, Int32)] = []
  for r in found {
    match merged.last() {
      Some((lo, hi)) if r.0 <= hi + 1 =>
        merged[merged.length() - 1] = (lo, hi.max(r.1))
      _ => merged.push(r)
    }
  }
  merged
}

///|
fn table(name : String, doc : String, rs : Array[(Int32, Int32)]) -> String {
  let out = StringBuilder()
  out.write_string(
    "\n///|\n/// \{doc}: first and last code point of each range.\n",
  )
  out.write_string("let \{name} : FixedArray[Int] = [\n")
  for r in rs {
    out.write_string(
      "  0x\{r.0.to_string(radix=16)}, 0x\{r.1.to_string(radix=16)},\n",
    )
  }
  out.write_string("]\n")
  out.to_string()
}

///|
async fn main {
  guard @env.args()[1:].to_owned() is [path] else {
    eprintln(
      "usage: moon run scripts/gen_identifier_tables.mbtx -- <DerivedCoreProperties.txt>",
    )
    @env.exit(2)
  }
  let source = @fs.read_text(path)
  guard source.split("\n").next() is Some(first) &&
    first.has_prefix("# DerivedCoreProperties-") else {
    eprintln("\{path}: not a DerivedCoreProperties.txt")
    @env.exit(1)
  }
  let version = first["# DerivedCoreProperties-".length():]
    .trim_end(chars=".txt")
    .to_owned()
  let start = ranges(source, "ID_Start") catch {
    e => {
      eprintln("\{path}: \{e}")
      @env.exit(1)
    }
  }
  let cont = ranges(source, "ID_Continue") catch {
    e => {
      eprintln("\{path}: \{e}")
      @env.exit(1)
    }
  }
  let raw = "// GENERATED by scripts/gen_identifier_tables.mbtx from Unicode \{version} DerivedCoreProperties.txt — DO NOT EDIT.\n" +
    table("id_start_ranges", "Unicode \{version} ID_Start", start) +
    table("id_continue_ranges", "Unicode \{version} ID_Continue", cont)
  // As moon fmt lays it out, so the static gates' fmt check passes.
  let fmt = @shell.Cmd("moonfmt", ["-"], stdin=Text(raw)).output(
    max_output_bytes=1 << 24,
  )
  fmt.check()
  let text = fmt.stdout()
  if @fs.exists(target) && @fs.read_text(target) == text {
    println("unchanged \{target}")
  } else {
    @fs.write_text(target, text)
    println(
      "wrote \{target}: \{start.length()} ID_Start and \{cont.length()} ID_Continue ranges",
    )
  }
}
