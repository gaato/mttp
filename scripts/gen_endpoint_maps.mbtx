----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
}
----

// Pair composition preserves staged decoding and accumulates head failures
// without casts or a runtime heterogeneous input container.
async fn main {
  let out = StringBuilder()
  out.write_string("// Generated by scripts/gen_endpoint_maps.mbtx.\n\n")
  for size in 3..<9 {
    let types = Array::makei(size, i => "A\{i}")
    let inputs = Array::makei(size, i => "a\{i}")
    let values = Array::makei(size, i => "v\{i}")
    let mut nested = "(v0, v1)"
    let mut composed = "pair(a0, a1)"
    for i in 2..<size {
      nested = "(\{nested}, v\{i})"
      composed = "pair(\{composed}, a\{i})"
    }
    out.write_string("///|\n/// Combines \{size} typed inputs through staged pair composition.\n")
    out.write_string("pub fn[\{types.join(", ")}, T] Input::map\{size}(\n")
    for i, name in inputs { out.write_string("  \{name} : Input[\{types[i]}],\n") }
    out.write_string("  to : (\{types.join(", ")}) -> T,\n  from : (T) -> (\{types.join(", ")}),\n) -> Input[T] {\n")
    out.write_string("  \{composed}.map(\n    nested => { let \{nested} = nested; to(\{values.join(", ")}) },\n    value => { let (\{values.join(", ")}) = from(value); \{nested} },\n  )\n}\n\n")
  }
  @fs.write_file("mttp/src/endpoint/maps.mbt", out.to_string())
  let tests = StringBuilder()
  tests.write_string("// Generated by scripts/gen_endpoint_maps.mbtx.\n\n")
  for size in 3..<9 {
    let values = Array::makei(size, i => "v\{i}")
    let inputs = Array::makei(size, i => "@endpoint.query(\"q\{i}\", @schema.int)")
    let tuple = Array::makei(size, i => "values[\{i}]").join(", ")
    tests.write_string("///|\ntest \"map\{size} preserves order and collects all missing inputs\" {\n")
    tests.write_string("  let input = @endpoint.Input::map\{size}(\{inputs.join(", ")}, (\{values.join(", ")}) => [\{values.join(", ")}], values => (\{tuple}))\n")
    tests.write_string("  let expected = [\{Array::makei(size, i => (i + 10).to_string()).join(", ")}]\n")
    tests.write_string("  let request = @endpoint.endpoint.post(\"/\").input(input).request((), expected).raw()\n")
    tests.write_string("  @driver.run_sync(() => {\n    assert_eq(decoded(input, request), expected)\n    assert_eq(refused(input, @model.Request::post(\"/\")).length(), \{size})\n  })\n}\n\n")
  }
  @fs.write_file("mttp/src/endpoint/maps_test.mbt", tests.to_string())
}
