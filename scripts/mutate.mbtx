----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
}
----

// A deliberately small, reviewable mutation sample for the HTTP/1 codec.
// Every mutant is applied to a disposable copy, never to the working tree.
// The sample emphasizes framing boundaries and branches whose wrong result can
// still parse and compile; adding every syntactic operator would mostly repeat
// the same decision and make this hand-run audit needlessly slow.

///|
struct Site {
  id : String
  path : String
  rule : String
  old : String
  new : String
  equivalent : String?
}

///|
suberror MutationError {
  MutationError(String)
}

///|
enum TestRun {
  Completed(@shell.Output)
  TimedOut
}

///|
fn site(
  id : String,
  path : String,
  rule : String,
  old : String,
  new_ : String,
  equivalent? : String,
) -> Site {
  { id, path, rule, old, new: new_, equivalent, }
}

