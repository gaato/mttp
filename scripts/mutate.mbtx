///|
async fn command(program : String, args : Array[String]) -> @shell.Output {
  @shell.Cmd(program, args).output(timeout_ms=120000, max_output_bytes=1048576)
}

///|
async fn copy_source(root : String) -> String {
  let archive = root + "/source.tar"
  let source = root + "/source"
  @fs.mkdir(source)
  command("tar", [
    "--exclude=mttp_core/_build", "--exclude=mttp_core/target", "--exclude=mttp_core/.mooncakes",
    "-cf", archive, "mttp_core",
  ]).check()
  command("tar", ["-xf", archive, "-C", source]).check()
  @fs.write_text(source + "/moon.work", "members = [\"mttp_core\"]\n")
  source
}

///|
async fn run_tests(moon : String, source : String) -> @shell.Output {
  let vars = { "MOON_CC": @env.get_env_var("MOON_CC").unwrap_or("cc") }
  // GNU timeout puts the command in a separate process group unless
  // --foreground is used, so both TERM and the follow-up KILL reach the native
  // test executable and its descendants rather than only the moon process.
  @shell.Cmd(
    "timeout",
    [
      "--signal=TERM", "--kill-after=5s", "120s", moon, "test", "--target", "native",
      "mttp_core/src/h1", "mttp_core/src/h1client", "mttp_core/src/h1server",
    ],
    cwd=source,
    env=vars,
  ).output(max_output_bytes=16777216)
}

///|
fn selected(site : Site, wanted : Array[String]) -> Bool {
  wanted.is_empty() || wanted.contains(site.id)
}

///|
async fn main {
  let args = @env.args()[1:].to_owned()
  if args is ["--list"] {
    for site in sites {
      let classification = site.equivalent
        .map(reason => "equivalent: " + reason)
        .unwrap_or("")
      println("\{site.id}\t\{site.rule}\t\{site.path}\t\{classification}")
    }
    return
  }
  for id in args {
    guard sites.any(site => site.id == id) else {
      raise MutationError("unknown mutation site: " + id)
    }
  }
  let root = @fs.tmpdir(prefix="mttp-mutate-")
  println("mutate: disposable copy at " + root)
  defer @fs.rmdir(root, recursive=true)
  let source = copy_source(root)
  let moon = command("which", ["moon"]).stdout().trim().to_owned()
  let baseline = run_tests(moon, source)
  if baseline.exit_code() != 0 {
    println(baseline.stdout())
    eprintln(baseline.stderr())
    raise MutationError("baseline tests failed")
  }
  println("BASELINE\tPASS")
  let mut killed = 0
  let mut survived = 0
  let mut equivalent = 0
  let mut timeout = 0
  for site in sites {
    if !selected(site, args) {
      continue
    }
    let path = source + "/" + site.path
    let original = @fs.read_text(path)
    let pieces = original.split(site.old).collect()
    guard pieces.length() == 2 else {
      raise MutationError(
        "\{site.id}: expected one occurrence, found \{pieces.length() - 1}",
      )
    }
    @fs.write_text(path, original.replace(old=site.old, new=site.new))
    let run = Completed(run_tests(moon, source)) catch {
      @async.TimeoutError => TimedOut
      error => raise error
    }
    @fs.write_text(path, original)
    match run {
      TimedOut => {
        timeout += 1
        println("TIMEOUT\t\{site.id}\t\{site.rule}\t\{site.path}")
      }
      Completed(result) => {
        let exit_code = result.exit_code()
        let log = result.stdout() + result.stderr()
        // Shells expose timeout's forced SIGKILL as 137; @shell normalizes the
        // same signal exit to -9.
        if exit_code == 0 {
          match site.equivalent {
            Some(reason) => {
              equivalent += 1
              println(
                "EQUIVALENT\t\{site.id}\t\{site.rule}\t\{site.path}\t\{reason}",
              )
            }
            None => {
              survived += 1
              println("SURVIVED\t\{site.id}\t\{site.rule}\t\{site.path}")
            }
          }
        } else if exit_code == 124 ||
          exit_code == 137 ||
          exit_code == -9 ||
          log.to_lower().contains("timed out") {
          timeout += 1
          println("TIMEOUT\t\{site.id}\t\{site.rule}\t\{site.path}")
        } else {
          killed += 1
          println("KILLED\t\{site.id}\t\{site.rule}\t\{site.path}")
        }
      }
    }
  }
  println(
    "SUMMARY\tsites=\{killed + survived + equivalent + timeout}\tkilled=\{killed}\tsurvived=\{survived}\tequivalent=\{equivalent}\ttimeout=\{timeout}",
  )
  if survived != 0 || timeout != 0 {
    raise MutationError(
      "mutation audit failed: survived=\{survived}, timeout=\{timeout}",
    )
  }
}
