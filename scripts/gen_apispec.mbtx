----
import { "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/fs" }
----

// A small data-only model table generates explicit codecs so optional fields
// are omitted and x-* extensions are flattened rather than nested in JSON.
struct Field { name : String; wire : String; type_ : String; default : String? }
fn f(name : String, type_ : String, wire? : String, default? : String) -> Field {
  { name, wire: wire.unwrap_or(name), type_, default: if type_.has_suffix("?") { Some("None") } else { default } }
}
async fn main {
  let records : Array[(String, Array[Field])] = [
    ("Info", [f("title", "String"), f("version", "String"), f("description", "String?")]),
    ("Server", [f("url", "String"), f("description", "String?")]),
    ("Tag", [f("name", "String"), f("description", "String?")]),
    ("Parameter", [f("name", "String"), f("in_", "String", wire="in"), f("required", "Bool", default="false"), f("schema", "Json", default="{}"), f("description", "String?"), f("style", "String?"), f("explode", "Bool?")]),
    ("HeaderObject", [f("required", "Bool", default="false"), f("schema", "Json", default="{}"), f("description", "String?")]),
    ("MediaTypeObject", [f("schema", "Json", default="{}")]),
    ("ResponseObject", [f("description", "String"), f("headers", "Map[String, HeaderObject]", default="{}"), f("content", "Map[String, MediaTypeObject]", default="{}")]),
    ("RequestBody", [f("content", "Map[String, MediaTypeObject]"), f("required", "Bool", default="false"), f("description", "String?")]),
    ("Operation", [f("responses", "Map[String, ResponseObject]"), f("operation_id", "String?", wire="operationId"), f("summary", "String?"), f("description", "String?"), f("tags", "Array[String]", default="[]"), f("deprecated", "Bool", default="false"), f("parameters", "Array[Parameter]", default="[]"), f("request_body", "RequestBody?", wire="requestBody"), f("security", "Array[Map[String, Array[String]]]", default="[]")]),
    ("SecurityScheme", [f("type_", "String", wire="type"), f("scheme", "String?"), f("name", "String?"), f("in_", "String?", wire="in"), f("bearer_format", "String?", wire="bearerFormat"), f("description", "String?")]),
    ("Components", [f("schemas", "Map[String, Json]", default="{}"), f("security_schemes", "Map[String, SecurityScheme]", wire="securitySchemes", default="{}")]),
    ("OpenApi", [f("info", "Info"), f("paths", "Map[String, PathItem]"), f("openapi", "String", default="\"3.1.0\""), f("servers", "Array[Server]", default="[]"), f("components", "Components", default="Components::new()"), f("tags", "Array[Tag]", default="[]")]),
  ]
  let out = StringBuilder()
  out.write_string("// Generated by scripts/gen_apispec.mbtx.\n\n")
  for (name, fields) in records {
    out.write_string("///|\n/// OpenAPI 3.1 \{name} data with flattened x-* extensions.\npub(all) struct \{name} {\n")
    for field in fields { out.write_string("  \{field.name} : \{field.type_}\n") }
    out.write_string("  extensions : Map[String, Json]\n} derive(Eq, Debug)\n\n")
    out.write_string("///|\n/// Creates \{name} data with defaults for optional fields.\npub fn \{name}::new(\n")
    for field in fields {
      if field.type_.has_suffix("?") {
        out.write_string("  \{field.name}? : \{field.type_[:field.type_.length() - 1]},\n")
      } else if field.default is Some(default) {
        out.write_string("  \{field.name}~ : \{field.type_} = \{default},\n")
      } else { out.write_string("  \{field.name} : \{field.type_},\n") }
    }
    out.write_string("  extensions~ : Map[String, Json] = {},\n) -> \{name} {\n  { \{fields.map(f => f.name).join(", ")}, extensions: extensions.copy() }\n}\n\n")
    out.write_string("///|\n/// Encodes \{name}, omitting absent optional fields.\npub impl ToJson for \{name} with fn to_json(self) {\n  let obj = extension_fields(self.extensions)\n")
    for field in fields {
      if field.type_.has_suffix("?") {
        out.write_string("  if self.\{field.name} is Some(value) { obj[\{Json(field.wire).stringify()}] = Json(value) }\n")
      } else { out.write_string("  obj[\{Json(field.wire).stringify()}] = Json(self.\{field.name})\n") }
    }
    out.write_string("  Json::object(obj)\n}\n\n")
    out.write_string("///|\n/// Decodes \{name} while retaining extension fields.\npub impl @json.FromJson for \{name} with fn from_json(value, path) {\n  let obj = expect_object(value, path)\n  {\n")
    for field in fields {
      if field.type_.has_suffix("?") {
        out.write_string("    \{field.name}: optional_field(obj, \{Json(field.wire).stringify()}, path),\n")
        continue
      }
      let default = match field.default { Some(v) => ", default=" + v; None => "" }
      out.write_string("    \{field.name}: field(obj, \{Json(field.wire).stringify()}, path\{default}),\n")
    }
    out.write_string("    extensions: extension_fields(obj),\n  }\n}\n\n")
    out.write_string("///|\n/// Compares \{name} values.\npub extend \{name} with Eq::{equal, not_equal}\n\n")
    out.write_string("///|\n/// Formats \{name} values.\npub extend \{name} with @debug.Debug::{to_repr}\n\n")
    out.write_string("///|\n/// Serializes \{name} to a JSON value.\npub extend \{name} with ToJson::{to_json}\n\n")
    out.write_string("///|\n/// Deserializes \{name} at a JSON path.\npub extend \{name} with @json.FromJson::{from_json}\n\n")
  }
  @fs.write_file("mttp/src/apispec/models.mbt", out.to_string())
}
