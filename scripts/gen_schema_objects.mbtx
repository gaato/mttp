----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
}
----

// Generates mttp/src/schema/object.mbt: object1 to object8, one named object
// codec per arity. Fixed arities avoid a heterogeneous field container that
// would need runtime casts; the generated functions are ordinary MoonBit that
// a consumer could write by hand for a larger arity.
//
// Usage, from the repository root:
//   moon run scripts/gen_schema_objects.mbtx            (rewrites the file)
//   moon run scripts/gen_schema_objects.mbtx -- --check (fails if it is stale)
//
// The output is already in `moon fmt` style, so the check compares bytes.
//
// Exit status: 0 = written or up to date, 1 = stale, 2 = bad usage.

///|
/// Where the generated source goes, relative to the repository root.
let output : String = "mttp/src/schema/object.mbt"

///|
/// The largest arity generated.
let max_arity : Int32 = 8

///|
/// The source of `object<size>`.
fn object_fn(out : StringBuilder, size : Int32) -> Unit {
  let types = Array::makei(size, i => "A\{i}").join(", ")
  let fields = if size == 1 { "field" } else { "fields" }
  out.write_string(
    (
      $|///|
      $|/// Builds a named object codec with \{size} typed \{fields}, collecting every
      $|/// field issue.
      $|pub fn[T, \{types}] object\{size}(
      $|  name : String,
      $|
    ),
  )
  for i in 0..<size {
    out.write_string("  f\{i} : Field[T, A\{i}],\n")
  }
  out.write_string(
    (
      $|  make : (\{types}) -> T,
      $|) -> JsonCodec[T] {
      $|  {
      $|    missing_: None,
      $|    omit_: never_omit,
      $|    from_: (j, path, d) => {
      $|      let obj = expect_object(j, path)
      $|      let issues = []
      $|
    ),
  )
  for i in 0..<size {
    out.write_string("      let v\{i} = f\{i}.decode(obj, path, issues, d)\n")
  }
  let values = Array::makei(size, i => "v\{i}").join(", ")
  let somes = Array::makei(size, i => "Some(a\{i})").join(", ")
  let args = Array::makei(size, i => "a\{i}").join(", ")
  let (values, somes) = if size == 1 {
    (values, somes)
  } else {
    ("(\{values})", "(\{somes})")
  }
  out.write_string("      match \{values} {\n")
  // As moon fmt does: an arm wider than 80 columns breaks after the arrow,
  // and a pattern wider than that puts one element per line.
  let arm = "        \{somes} => make(\{args})"
  if arm.length() <= 80 {
    out.write_string(arm + "\n")
  } else if "        \{somes}".length() <= 80 {
    out.write_string("        \{somes} =>\n          make(\{args})\n")
  } else {
    out.write_string("        (\n")
    for i in 0..<size {
      out.write_string("          Some(a\{i}),\n")
    }
    out.write_string("        ) => make(\{args})\n")
  }
  out.write_string(
    (
      $|        _ => raise invalid(issues)
      $|      }
      $|    },
      $|    to_: value => {
      $|      let obj : Map[String, Json] = Map([])
      $|
    ),
  )
  for i in 0..<size {
    out.write_string("      f\{i}.encode_field(obj, value)\n")
  }
  out.write_string("      Json::object(obj)\n    },\n")
  let described = Array::makei(size, i => "f\{i}.describe()").join(", ")
  let schema = "    schema_: object_schema(name, [\{described}]),"
  if schema.length() <= 80 {
    out.write_string(schema + "\n")
  } else {
    out.write_string("    schema_: object_schema(name, [\n")
    for i in 0..<size {
      out.write_string("      f\{i}.describe(),\n")
    }
    out.write_string("    ]),\n")
  }
  out.write_string(
    (
      $|  }
      $|}
      $|
    ),
  )
}

///|
/// The whole generated file.
fn generate() -> String {
  let out = StringBuilder()
  out.write_string(
    "// Generated by scripts/gen_schema_objects.mbtx. DO NOT EDIT.\n",
  )
  for size in 1..<=max_arity {
    out.write_string("\n")
    object_fn(out, size)
  }
  out.to_string()
}

///|
async fn main {
  let text = generate()
  match @env.args() {
    [_] => @fs.write_text(output, text)
    [_, "--check"] => {
      let current = @fs.read_text(output) catch { _ => "" }
      if current != text {
        eprintln(
          "\{output} is stale: run 'moon run scripts/gen_schema_objects.mbtx'",
        )
        @env.exit(1)
      }
    }
    _ => {
      eprintln("usage: moon run scripts/gen_schema_objects.mbtx [-- --check]")
      @env.exit(2)
    }
  }
}
