----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
}
----

// Fixed arities avoid a runtime cast-based heterogeneous field container.
// Generated functions remain ordinary MoonBit that consumers can write by hand.
async fn main {
  let out = StringBuilder()
  out.write_string("// Generated by scripts/gen_schema_objects.mbtx.\n\n")
  for size in 1..<9 {
    let names = Array::makei(size, i => "f\{i}")
    let types = Array::makei(size, i => "A\{i}")
    let type_list = types.join(", ")
    let name_list = names.join(", ")
    out.write_string("///|\n/// Builds a named object codec with \{size} typed fields, collecting every field issue.\n")
    out.write_string("pub fn[T, \{type_list}] object\{size}(name : String,\n")
    for i, name in names { out.write_string("  \{name} : Field[T, \{types[i]}],\n") }
    out.write_string("  make : (\{type_list}) -> T,\n) -> JsonCodec[T] {\n  {\n    missing_: None, omit_: never_omit,\n    from_: (j, path) => {\n      guard j is Object(obj) else {\n        raise invalid([{ path, code: \"type\", message: \"expected object\" }])\n      }\n      let issues = []\n")
    for name in names { out.write_string("      let v\{name} = \{name}.decode(obj, path, issues)\n") }
    let values = names.map(n => "v"+n).join(", ")
    let patterns = names.map(n => "Some("+n+")").join(", ")
    let values = if size == 1 { values } else { "("+values+")" }
    let patterns = if size == 1 { patterns } else { "("+patterns+")" }
    out.write_string("      match \{values} {\n        \{patterns} => make(\{name_list})\n        _ => raise invalid(issues)\n      }\n    },\n    to_: value => {\n      let obj : Map[String, Json] = Map([])\n")
    for name in names { out.write_string("      \{name}.encode_field(obj, value)\n") }
    out.write_string("      Json::object(obj)\n    },\n    schema_: object_schema(name, [\n")
    for name in names { out.write_string("      (\{name}.name, \{name}.codec.schema_, \{name}.codec.missing_ is None),\n") }
    out.write_string("    ]),\n  }\n}\n\n")
  }
  @fs.write_file("mttp/src/schema/object.mbt", out.to_string())
}
