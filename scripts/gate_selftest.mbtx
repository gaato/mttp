----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
}
----

// Exercises the real entry point, `scripts/gates.sh quick`, on a tiny copy of
// the workspace: one four-target module and one runtime module that imports
// moonbitlang/core/async. Each probe changes one thing and expects the gate
// to fail with a given message, so the count parser and the experimental
// warning check are tested where they run, not in a copy.

///|
suberror SelfTestFailed {
  SelfTestFailed(String)
}

///|
let modules_tsv : String =
  #|# The self-test's modules.
  #|dir	name	kind	targets	module_deps	package_imports	experimental	release	gate
  #|portable	selftest/portable	four-target	wasm-gc,wasm,js,native	-	moonbitlang/core	-	yes	full
  #|runtime	selftest/runtime	runtime	native	-	moonbitlang/core	moonbitlang/core/async	yes	full
  #|benchmark	selftest/benchmark	benchmark	native	-	moonbitlang/core	-	no	full
  #|

///|
let runtime_pkg : String =
  #|import {
  #|  "moonbitlang/core/async",
  #|} for "test"
  #|
  #|options(
  #|  "allow-experimental-packages": [ "moonbitlang/core/async" ],
  #|)
  #|

///|
let runtime_test : String =
  #|///|
  #|async test "runs" {
  #|  @async.sleep(1)
  #|}
  #|

///|
async fn probe(root : String, name : String, expected : String?) -> Unit {
  let output = @shell.Cmd(
    "bash",
    ["scripts/gates.sh", "quick", "--target", "native"],
    cwd=root,
  ).output(timeout_ms=300000)
  let log = output.stdout() + output.stderr()
  @fs.write_text(root + "/" + name.replace_all(old=" ", new="-") + ".log", log)
  let correct = match expected {
    None => output.exit_code() == 0 && log.contains("gates: OK")
    Some(message) => output.exit_code() != 0 && log.contains(message)
  }
  if !correct {
    println(log)
    println("gate self-test evidence: " + root)
    raise SelfTestFailed("gate self-test failed: " + name)
  }
  println("gate self-test: " + name + " OK")
}

///|
/// Exercise the actual mbti scan so skipping internal adapters cannot also
/// exempt a public package that exposes an experimental runtime handle.
async fn probe_interfaces(root : String, name : String, refused : Bool) -> Unit {
  let output = @shell.Cmd(
    "moon",
    ["run", "scripts/runtime_gates.mbtx", "--", "interfaces"],
    cwd=root,
  ).output(timeout_ms=300000)
  let log = output.stdout() + output.stderr()
  @fs.write_text(root + "/" + name.replace_all(old=" ", new="-") + ".log", log)
  let correct = if refused {
    output.exit_code() != 0 &&
    log.contains("selftest/runtime on native: the public interface mentions")
  } else {
    output.exit_code() == 0 && log.contains("runtime interfaces: OK")
  }
  if !correct {
    println(log)
    println("gate self-test evidence: " + root)
    raise SelfTestFailed("gate interface self-test failed: " + name)
  }
  println("gate self-test: " + name + " OK")
}

///|
/// Runs the copy of scripts/release.mbtx in `root`, as a caller would.
async fn release(root : String, args : Array[String]) -> @shell.Output {
  @shell.Cmd("moon", ["run", "scripts/release.mbtx", "--", ..args], cwd=root).output(
    timeout_ms=300000,
  )
}

///|
/// Release selection must not depend on test kind: a private four-target
/// harness is still tested, but is not a changelog requirement or bump target.
/// A bump must reach every moon.work member that imports the module, nested
/// ones such as examples/* included, not only top-level directories.
async fn probe_release(parent : String) -> Unit {
  let root = parent + "/release-selection"
  @fs.mkdir(root + "/scripts", recursive=true)
  @fs.write_text(
    root + "/scripts/release.mbtx",
    @fs.read_text("scripts/release.mbtx"),
  )
  @fs.write_text(
    root + "/scripts/modules.tsv",
    "dir\tname\tkind\ttargets\tmodule_deps\tpackage_imports\texperimental\trelease\tgate\n" +
    "library\tprobe/library\tfour-target\tnative\t-\t*\t-\tyes\tfull\n" +
    "private\tprobe/private\tfour-target\tnative\tprobe/library\t*\t-\tno\tfull\n" +
    "app\tprobe/app\texample\tnative\t-\t*\t-\tno\tfull\n" +
    "examples/nested\tprobe/nested\texample\tnative\t-\t*\t-\tno\tfull\n",
  )
  @fs.write_text(
    root + "/moon.work",
    "members = [\n  \"library\",\n  \"private\",\n  \"app\",\n  \"./examples/nested/\",\n]\n",
  )
  for dir in ["library", "private", "app", "examples/nested"] {
    @fs.mkdir(root + "/" + dir, recursive=true)
    @fs.write_text(
      root + "/" + dir + "/moon.mod",
      "name = \"probe/" +
      dir.replace(old="examples/", new="") +
      "\"\nversion = \"0.0.1\"\nimport {\n  \"probe/library@0.0.1\",\n}\n",
    )
  }
  // No changelogs for either excluded row: check must consider only library.
  @fs.write_text(
    root + "/library/CHANGELOG.md",
    "# Changelog\n\n## [Unreleased]\n\n- Example.\n",
  )
  let checked = release(root, ["check"])
  guard checked.exit_code() == 0 &&
    checked.stdout().contains("OK (1 changelogs)") else {
    raise SelfTestFailed("release check included a private module or app")
  }
  for dir in ["private", "app", "examples/nested", "unlisted"] {
    let refused = release(root, ["bump", dir, "9.9.9"])
    guard refused.exit_code() == 2 &&
      refused.stderr().contains("is not a release module") else {
      raise SelfTestFailed("release bump accepted " + dir)
    }
    if dir != "unlisted" &&
      @fs.read_text(root + "/" + dir + "/moon.mod").contains("9.9.9") {
      raise SelfTestFailed("refused release bump mutated " + dir)
    }
  }
  let bumped = release(root, ["bump", "library", "0.0.2"])
  guard bumped.exit_code() == 0 &&
    @fs.read_text(root + "/library/moon.mod").contains("version = \"0.0.2\"") &&
    @fs.read_text(root + "/library/CHANGELOG.md").contains("## [0.0.2] - ") &&
    @fs.read_text(root + "/private/moon.mod").contains("version = \"0.0.1\"") &&
    @fs.read_text(root + "/private/moon.mod").contains("probe/library@0.0.2") else {
    raise SelfTestFailed(
      "release bump failed or changed a private module's version",
    )
  }
  let nested = @fs.read_text(root + "/examples/nested/moon.mod")
  guard nested.contains("\"probe/library@0.0.2\"") &&
    !nested.contains("probe/library@0.0.1") &&
    nested.contains("version = \"0.0.1\"") else {
    raise SelfTestFailed(
      "release bump left a nested workspace member on the old version",
    )
  }
  println(
    "gate self-test: release selection, bump guards and nested members OK",
  )
}

///|
async fn main {
  let root = @fs.tmpdir(prefix="mttp-gate-selftest-")
  probe_release(root)
  @fs.mkdir(root + "/scripts")
  for
    file in [
      "scripts/gates.sh", "scripts/runtime_gates.mbtx", "moonbit-version",
    ] {
    @fs.write_text(root + "/" + file, @fs.read_text(file))
  }
  @fs.write_text(root + "/scripts/modules.tsv", modules_tsv)
  @fs.write_text(
    root + "/moon.work",
    "members = [\"portable\", \"runtime\", \"benchmark\"]\n",
  )
  @fs.mkdir(root + "/benchmark")
  @fs.write_text(
    root + "/benchmark/moon.mod",
    "name = \"selftest/benchmark\"\nversion = \"0.0.0\"\nsource = \".\"\nsupported_targets = \"native\"\n",
  )
  @fs.write_text(
    root + "/benchmark/moon.pkg",
    "pkgtype(kind: \"executable\")\n",
  )
  // Both main and tests abort if executed: the benchmark kind must build
  // the executable while leaving it out of test runs and their manifest.
  @fs.write_text(
    root + "/benchmark/main.mbt",
    "///|\nfn main { abort(\"benchmark ran\") }\n",
  )
  @fs.write_text(
    root + "/benchmark/main_test.mbt",
    "///|\ntest { fail(\"benchmark test ran\") }\n",
  )
  let rows = ["module\tpackage\ttarget\tcount"]
  for
    (dir, name, targets) in [
      ("portable", "selftest/portable", ["native", "js", "wasm", "wasm-gc"]),
      ("runtime", "selftest/runtime", ["native"]),
    ] {
    @fs.mkdir(root + "/" + dir + "/src", recursive=true)
    @fs.write_text(
      root + "/" + dir + "/moon.mod",
      "name = \"" + name + "\"\nversion = \"0.0.1\"\nsource = \"src\"\n",
    )
    for target in targets {
      rows.push(name + "\t" + name + "\t" + target + "\t1")
    }
  }
  @fs.write_text(root + "/portable/src/moon.pkg", "")
  @fs.write_text(root + "/runtime/src/moon.pkg", runtime_pkg)
  @fs.write_text(root + "/runtime/src/runs_test.mbt", runtime_test)
  let manifest = rows.join("\n") + "\n"
  let source = root + "/portable/src/check_test.mbt"
  let visible = "///|\ntest \"visible\" {\n  assert_true(true)\n}\n"
  @fs.write_text(source, visible)
  @fs.write_text(root + "/scripts/test_manifest.tsv", manifest)
  probe(root, "passing baseline", None)
  guard @fs.exists(
    root + "/_build/native/debug/build/selftest/benchmark/benchmark.exe",
  ) else {
    raise SelfTestFailed("benchmark executable was not built")
  }
  @fs.write_text(
    root + "/benchmark/main.mbt",
    "///|\nfn main { missing_function() }\n",
  )
  probe(
    root,
    "broken benchmark refused",
    Some("moon build selftest/benchmark on native"),
  )
  @fs.write_text(
    root + "/benchmark/main.mbt",
    "///|\nfn main { abort(\"benchmark ran\") }\n",
  )
  @fs.write_text(source, "")
  probe(root, "unexpected zero", Some("0 tests, and"))
  @fs.write_text(source, "///|\ntest \"failed\" {\n  assert_true(false)\n}\n")
  probe(root, "failed assertion", Some("moon test exited with status"))
  @fs.write_text(
    source,
    visible + "\n///|\ntest \"extra\" {\n  assert_true(true)\n}\n",
  )
  probe(root, "unexpected extra test", Some("test counts differ from"))
  @fs.write_text(source, visible)
  @fs.write_text(
    root + "/scripts/test_manifest.tsv",
    rows.filter(row => !row.has_prefix("selftest/portable\t")).join("\n") + "\n",
  )
  probe(root, "missing manifest entry", Some("test counts differ from"))
  @fs.write_text(root + "/scripts/test_manifest.tsv", manifest)
  @fs.write_text(
    root + "/runtime/src/moon.pkg",
    "import {\n  \"moonbitlang/core/async\",\n} for \"test\"\n",
  )
  probe(
    root,
    "unlisted experimental package",
    Some("an experimental package is used but not listed"),
  )
  @fs.write_text(root + "/runtime/src/moon.pkg", runtime_pkg)
  probe(root, "restored baseline", None)
  @fs.write_text(root + "/scripts/non_exhaustive.tsv", "package\tenum\n")
  let bridge_pkg = runtime_pkg.replace_all(old="} for \"test\"", new="}")
  let bridge_source = "///|\npub fn handle(timer : @async.Timer) -> Unit { ignore(timer) }\n"
  @fs.write_text(root + "/runtime/src/moon.pkg", bridge_pkg)
  @fs.write_text(root + "/runtime/src/exposed.mbt", bridge_source)
  probe_interfaces(root, "public runtime handle refused", true)
  @fs.remove(root + "/runtime/src/exposed.mbt")
  @fs.write_text(root + "/runtime/src/moon.pkg", runtime_pkg)
  @fs.mkdir(root + "/runtime/src/internal/bridge", recursive=true)
  @fs.write_text(root + "/runtime/src/internal/bridge/moon.pkg", bridge_pkg)
  @fs.write_text(
    root + "/runtime/src/internal/bridge/bridge.mbt",
    bridge_source,
  )
  probe_interfaces(root, "internal runtime handle accepted", false)
  // The copy holds native build output; keep it only when a probe fails.
  @fs.rmdir(root, recursive=true)
}
