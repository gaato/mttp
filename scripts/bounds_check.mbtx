----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
}
----

// Checks the test citations in the repository's resource and security ledgers.
//
// Every resource-bound row's last cell ("Tests") names the tests that check
// its bound, as a
// backticked file path followed by the quoted names of that file's tests:
//
//   `mttp_core/src/sse/parser_test.mbt`: "first test", "second test"; `mttp_core/src/h1/head_wbtest.mbt`: "third"
//
// SECURITY_CLASSES.md uses the same citation syntax in its last column. A
// security row may instead say "gap" or explain why the class does not apply;
// every test it does cite must exist. File paths are relative to the directory
// that holds the ledgers: the repository root.
//
// The check fails when a resource-bound row names no test, a name comes before
// any file, a file does not exist, or a file declares no `test "<name>" {` or
// `async test "<name>" {` line with that exact name. It does not judge whether
// a test really drives the bound; that is the reviewer's job (see the ledger's
// header).
//
// Usage, from the repository root:
//   moon run scripts/bounds_check.mbtx [--self-test | DIR]
//
// A table with a header and no rows passes: rows arrive with the code that
// enforces them.
//
// Exit status: 0 = every required citation exists, 1 = a ledger/table/citation
// is invalid, 2 = usage is invalid.

///|
/// Prints `message` on stderr and exits with `code`.
fn[T] die(code : Int32, message : String) -> T {
  eprintln(message)
  @env.exit(code)
}

///|
/// Whether `path` is a regular file, or a link to one.
async fn is_file(path : String) -> Bool {
  (@fs.kind(path) is Regular) catch {
    _ => false
  }
}

///|
/// What a row of the table names.
enum Finding {
  /// A test `name` declared in `file`.
  Test(file~ : String, name~ : String)
  /// A test name before any file in its cell.
  Orphan(name~ : String)
  /// A row that names no test.
  Empty
}

///|
/// One ledger table checked by this script.
priv struct Ledger {
  file : String
  section : String
  column : String
  rows_need_tests : Bool
  noun : String
}

///|
let ledgers : Array[Ledger] = [
  {
    file: "RESOURCE_BOUNDS.md",
    section: "Enforced limits",
    column: "Tests",
    rows_need_tests: true,
    noun: "enforced limits",
  },
  {
    file: "SECURITY_CLASSES.md",
    section: "Security classes",
    column: "Defending tests / status",
    rows_need_tests: false,
    noun: "security classes",
  },
]

///|
/// The rows of one named table: its header's last cell, and each
/// row's label (the first cell up to " (") with what it names.
fn table(
  text : String,
  section : String,
) -> (String?, Array[(String, Finding)]) {
  let found = []
  let mut header = None
  let mut in_table = false
  let mut seen_header = false
  for raw in text.split("\n") {
    let line = raw.to_owned()
    if line.has_prefix("## ") {
      in_table = line == "## " + section
      seen_header = false
      continue
    }
    if !in_table || !line.has_prefix("|") || separator(line) {
      continue
    }
    // A row starts and ends with "|", so the first and last fields are empty.
    let cells = line.split("|").to_array()
    let first = cells[1].trim(chars=" ").to_owned()
    let last = cells[cells.length() - 2].trim(chars=" ").to_owned()
    if !seen_header {
      seen_header = true
      if header is None {
        header = Some(last)
      }
      continue
    }
    let label = match first.find(" (") {
      Some(at) => first.clamped_view(end=at).to_owned()
      None => first
    }
    let before = found.length()
    let mut file = ""
    for token in tokens(last) {
      match token {
        File(path) => file = path
        Name(name) if file == "" => found.push((label, Orphan(name~)))
        Name(name) => found.push((label, Test(file~, name~)))
      }
    }
    if found.length() == before {
      found.push((label, Empty))
    }
  }
  (header, found)
}

///|
/// A row like `|---|:--:|`.
fn separator(line : String) -> Bool {
  line.length() >= 3 &&
  line.has_suffix("|") &&
  line
  .clamped_view(start=1, end=line.length() - 1)
  .iter()
  .all(c => c is ('-' | ':' | '|' | ' '))
}

///|
priv enum Token {
  File(String)
  Name(String)
}

///|
/// The backticked paths and the quoted names of a cell, in order. A quote or
/// backtick without its closing one is skipped.
fn tokens(cell : String) -> Array[Token] {
  let out = []
  for i = 0; i < cell.length(); {
    let c = cell[i]
    if c == '`' || c == '"' {
      let close = cell
        .clamped_view(start=i + 1)
        .find(if c == '`' { "`" } else { "\"" })
      if close is Some(len) {
        let token = cell.clamped_view(start=i + 1, end=i + 1 + len).to_owned()
        out.push(if c == '`' { File(token) } else { Name(token) })
        continue i + len + 2
      }
    }
    continue i + 1
  }
  out
}

///|
async fn check_ledger(
  module_root : String,
  ledger : Ledger,
  verbose~ : Bool,
) -> Bool {
  let path = "\{module_root}/\{ledger.file}"
  if !is_file(path) {
    if verbose {
      println("NO LEDGER   \{path}")
    }
    return false
  }
  let (header, found) = table(@fs.read_text(path), ledger.section)
  if header != Some(ledger.column) {
    if verbose {
      println(
        "NO TABLE    \{ledger.file}: expected ## \{ledger.section} with last column \{ledger.column}",
      )
    }
    return false
  }
  // The rows that name a test, in order, with the tests found.
  let rows : Map[String, Int32] = Map([])
  let mut bad = false
  let mut tests = 0
  // The lines of each named file, None for a file that does not exist.
  let declared : Map[String, Array[String]?] = Map([])
  for item in found {
    let (label, finding) = item
    if !rows.contains(label) {
      rows[label] = 0
    }
    match finding {
      Test(file~, name~) => {
        let test_path = "\{module_root}/\{file}"
        if !declared.contains(test_path) {
          declared[test_path] = if is_file(test_path) {
            Some(
              @fs.read_text(test_path)
              .split("\n")
              .map(line => line.to_owned())
              .to_array(),
            )
          } else {
            None
          }
        }
        guard declared[test_path] is Some(lines) else {
          if verbose {
            println("NO FILE     \{label}: \{file}")
          }
          bad = true
          continue
        }
        if lines.contains("test \"\{name}\" {") ||
          lines.contains("async test \"\{name}\" {") {
          rows[label] = rows[label] + 1
          tests += 1
        } else {
          if verbose {
            println("NO TEST     \{label}: \{file} has no test \"\{name}\"")
          }
          bad = true
        }
      }
      Orphan(name~) => {
        if verbose {
          println(
            "NO FILE     \{label}: \"\{name}\" follows no backticked file path",
          )
        }
        bad = true
      }
      Empty =>
        if ledger.rows_need_tests {
          if verbose {
            println("NO TESTS    \{label}: the row names no test")
          }
          bad = true
        }
    }
  }
  if verbose {
    for label, count in rows {
      println(
        "\{label.pad_end(56, ' ')} \{count.to_string().pad_start(2, ' ')} tests",
      )
    }
    if bad {
      println("\{ledger.file} check: FAIL")
    } else {
      println(
        "\{ledger.file} check: OK - \{rows.length()} \{ledger.noun} name \{tests} tests that exist",
      )
    }
  }
  !bad
}

///|
async fn check_all(module_root : String, verbose~ : Bool) -> Bool {
  let mut good = true
  for ledger in ledgers {
    if !check_ledger(module_root, ledger, verbose~) {
      good = false
    }
  }
  good
}

///|
async fn self_test() -> Unit {
  let root = @fs.tmpdir(prefix="mttp-ledger-check-")
  defer @fs.rmdir(root, recursive=true)
  @fs.write_text(root + "/exists_test.mbt", "test \"exists\" {\n}\n")
  @fs.write_text(
    root + "/RESOURCE_BOUNDS.md",
    (
      #|## Enforced limits
      #|
      #|| Structure | Tests |
      #||---|---|
      #|| bytes | `exists_test.mbt`: "exists" |
      #|
    ),
  )
  @fs.write_text(
    root + "/SECURITY_CLASSES.md",
    (
      #|## Security classes
      #|
      #|| Class | Defending tests / status |
      #||---|---|
      #|| covered | `exists_test.mbt`: "exists" |
      #|| planned | gap - later stage |
      #|
    ),
  )
  guard check_all(root, verbose=false) else {
    fail("ledger self-test rejected valid citations and a security gap")
  }
  @fs.write_text(
    root + "/SECURITY_CLASSES.md",
    (
      #|## Security classes
      #|
      #|| Class | Defending tests / status |
      #||---|---|
      #|| missing | `exists_test.mbt`: "absent" |
      #|
    ),
  )
  guard !check_all(root, verbose=false) else {
    fail("ledger self-test accepted a missing security test")
  }
  @fs.write_text(
    root + "/SECURITY_CLASSES.md",
    (
      #|## Security classes
      #|
      #|| Class | Defending tests / status |
      #||---|---|
      #|| planned | gap - later stage |
      #|
    ),
  )
  @fs.write_text(
    root + "/RESOURCE_BOUNDS.md",
    (
      #|## Enforced limits
      #|
      #|| Structure | Tests |
      #||---|---|
      #|| bytes | gap |
      #|
    ),
  )
  guard !check_all(root, verbose=false) else {
    fail("ledger self-test accepted a resource bound without a test")
  }
  println(
    "ledger check self-tests: valid citations, security gaps and missing tests OK",
  )
}

///|
async fn main {
  let args = @env.args()
  let (dir, self_testing) = match args {
    [_] => (".", false)
    [_, "--self-test"] => (".", true)
    [_, dir] => (dir, false)
    _ => die(2, "usage: moon run scripts/bounds_check.mbtx [--self-test | DIR]")
  }
  let cwd = @env.current_dir().unwrap_or(".")
  let module_root = "\{cwd}/\{dir.trim_end(chars="/")}"
  if !check_all(module_root, verbose=true) {
    @env.exit(1)
  }
  if self_testing {
    self_test()
  }
}
